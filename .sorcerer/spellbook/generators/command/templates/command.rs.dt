//! `{= crate =} {= command|kebab =}`: {= ? purpose: text | what the command prints =}

use std::io::Write;

use anyhow::Result;

/// Calls the use case and prints its result; the exit code is 0 when it ran.
pub(super) fn {= command_ =}(out: &mut dyn Write) -> Result<i32> {
    let result = {= ? call: expr | the one use case this command calls =};
    write!(out, "{}", {= command_ =}_text(&result))?;
    Ok(0)
}

/// The text the command prints.
fn {= command_ =}_text(result: &{= ? result_type: type | what the use case returns =}) -> String {
    {= ? text: block | the result as the user reads it =}
}
