{
  "name": "spellbook",
  "displayName": "Spellbook",
  "description": "Spellbook in VS Code: a project's generators with holes to fill, and its rules in Problems",
  "publisher": "sorcererdev",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorcererdev/sorcerer",
    "directory": "editors/vscode/spellbook"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "spellbook.path"
      ],
      "description": "In Restricted Mode the `spellbook.path` setting is not read; spellbook is looked up on PATH and in the usual places."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Spellbook",
      "properties": {
        "spellbook.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `spellbook` binary: an absolute path, read from your user settings only (a workspace's settings cannot choose the program the extension runs). Empty: `spellbook` (`spellbook.exe` on Windows) is looked up on `PATH`, then in `~/.cargo/bin`, `~/.local/bin` and the binary this extension downloaded."
        },
        "spellbook.conjureHoles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "After **Spellbook: New**, run conjure on the first hole (needs the Conjure extension, `sorcererdev.conjure`)."
        },
        "spellbook.holeSession": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After **Spellbook: New**, the opened file's holes become snippet placeholders: the first is selected, typing replaces it, `Tab` and `Shift+Tab` move between them. Off: the holes are only marked (Problems)."
        }
      }
    },
    "commands": [
      {
        "command": "spellbook.new",
        "title": "Generate…",
        "category": "spellbook"
      },
      {
        "command": "spellbook.fixThis",
        "title": "Fix this",
        "category": "spellbook"
      },
      {
        "command": "spellbook.fixHere",
        "title": "Fix",
        "category": "spellbook"
      },
      {
        "command": "spellbook.check",
        "title": "Check the project's rules",
        "category": "spellbook"
      },
      {
        "command": "spellbook.sync",
        "title": "Sync regions",
        "category": "spellbook"
      },
      {
        "command": "spellbook.holes",
        "title": "List holes",
        "category": "spellbook"
      },
      {
        "command": "spellbook.undoLast",
        "title": "Undo the last change",
        "category": "spellbook"
      }
    ],
    "keybindings": [
      {
        "command": "spellbook.new",
        "key": "ctrl+m g",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.new",
        "key": "ctrl+m b g",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.fixThis",
        "key": "ctrl+m f",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.fixHere",
        "key": "ctrl+m b f",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.check",
        "key": "ctrl+m b k",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.sync",
        "key": "ctrl+m b s",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.holes",
        "key": "ctrl+m b h",
        "when": "editorTextFocus"
      },
      {
        "command": "spellbook.undoLast",
        "key": "ctrl+m u",
        "when": "editorTextFocus && sorcerer.lastChange == spellbook"
      },
      {
        "command": "spellbook.undoLast",
        "key": "ctrl+m u",
        "when": "editorTextFocus && !sorcerer.lastChange"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node22 --sourcemap",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
