{
  "name": "apprentice",
  "displayName": "Apprentice",
  "description": "A coding agent whose whole interface is your editor: it answers and checks what you write, offers what you ask for, and works in your buffers when you accept. Runs Claude Code (claude -p) on your own subscription",
  "publisher": "sorcererdev",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorcererdev/sorcerer",
    "directory": "editors/vscode/apprentice"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "apprentice.path"
      ],
      "description": "In Restricted Mode the `apprentice.path` setting is not read; apprentice is looked up on PATH and in the usual places."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Apprentice",
      "properties": {
        "apprentice.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `apprentice` binary: an absolute path, read from your user settings only (a workspace's settings cannot choose the program the extension runs). Empty: `apprentice` (`apprentice.exe` on Windows) is looked up on `PATH`, then in `~/.cargo/bin`, `~/.local/bin` and the binary this extension downloaded."
        }
      }
    },
    "commands": [
      {
        "command": "apprentice.keys.do",
        "title": "Apprentice: Do this"
      },
      {
        "command": "apprentice.keys.stop",
        "title": "Apprentice: Stop this task"
      },
      {
        "command": "apprentice.keys.showDiff",
        "title": "Apprentice: Show diff"
      },
      {
        "command": "apprentice.keys.undoTask",
        "title": "Apprentice: Undo this task"
      },
      {
        "command": "apprentice.keys.journal",
        "title": "Apprentice: Show journal"
      },
      {
        "command": "apprentice.keys.dismiss",
        "title": "Apprentice: Dismiss"
      },
      {
        "command": "apprentice.keys.label",
        "title": "Apprentice: This was\u2026"
      }
    ],
    "keybindings": [
      {
        "command": "apprentice.keys.do",
        "key": "ctrl+m a",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.stop",
        "key": "ctrl+m q",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.showDiff",
        "key": "ctrl+m d",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.undoTask",
        "key": "ctrl+m z",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.journal",
        "key": "ctrl+m j",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.dismiss",
        "key": "ctrl+m x",
        "when": "editorTextFocus"
      },
      {
        "command": "apprentice.keys.label",
        "key": "ctrl+m l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node22 --sourcemap",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
