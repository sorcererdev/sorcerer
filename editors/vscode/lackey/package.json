{
  "name": "lackey",
  "displayName": "Lackey",
  "description": "A coding agent whose whole interface is your editor: it answers and checks what you write, offers what you ask for, and works in your buffers when you accept. Runs Claude Code (claude -p) on your own subscription",
  "publisher": "sorcererdev",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorcererdev/sorcerer",
    "directory": "editors/vscode/lackey"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "lackey.path"
      ],
      "description": "In Restricted Mode the `lackey.path` setting is not read; lackey is looked up on PATH and in the usual places."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Lackey",
      "properties": {
        "lackey.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `lackey` binary: an absolute path, read from your user settings only (a workspace's settings cannot choose the program the extension runs). Empty: `lackey` (`lackey.exe` on Windows) is looked up on `PATH`, then in `~/.cargo/bin`, `~/.local/bin` and the binary this extension downloaded."
        }
      }
    },
    "commands": [
      {
        "command": "lackey.keys.do",
        "title": "Do this",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.stop",
        "title": "Stop the running task",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.showDiff",
        "title": "Show the diff",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.undoTask",
        "title": "Undo the task",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.journal",
        "title": "Journal",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.openAnswer",
        "title": "Open the answer",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.dismiss",
        "title": "Dismiss",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.label",
        "title": "Label what you wrote",
        "category": "lackey"
      },
      {
        "command": "lackey.keys.undoLast",
        "title": "Undo the last change",
        "category": "lackey"
      }
    ],
    "keybindings": [
      {
        "command": "lackey.keys.do",
        "key": "ctrl+m a",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.do",
        "key": "ctrl+m l a",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.stop",
        "key": "ctrl+m q",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.stop",
        "key": "ctrl+m l q",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.showDiff",
        "key": "ctrl+m l d",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.undoTask",
        "key": "ctrl+m l z",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.journal",
        "key": "ctrl+m l j",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.openAnswer",
        "key": "ctrl+m l o",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.dismiss",
        "key": "ctrl+m l x",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.label",
        "key": "ctrl+m l l",
        "when": "editorTextFocus"
      },
      {
        "command": "lackey.keys.undoLast",
        "key": "ctrl+m u",
        "when": "editorTextFocus && sorcerer.lastChange == lackey"
      },
      {
        "command": "lackey.keys.undoLast",
        "key": "ctrl+m u",
        "when": "editorTextFocus && !sorcerer.lastChange"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node22 --sourcemap",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
