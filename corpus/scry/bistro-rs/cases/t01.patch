diff --git a/src/booking/queries/list_guest_bookings.rs b/src/booking/queries/list_guest_bookings.rs
new file mode 100644
index 0000000..f0687c3
--- /dev/null
+++ b/src/booking/queries/list_guest_bookings.rs
@@ -0,0 +1,54 @@
+//! Every booking a guest has made, across all days, oldest first (a query).
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+pub struct ListGuestBookings {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl ListGuestBookings {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> ListGuestBookings {
+        ListGuestBookings { bookings }
+    }
+
+    pub fn handle(&self, guest: &str) -> Vec<Booking> {
+        let mut bookings = self.bookings.bookings_for(guest);
+        bookings.sort_by_key(|a| a.slot);
+        bookings
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Slot, Time};
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    fn booking(id: &str, day: u32, guest: &str) -> Booking {
+        Booking {
+            id: id.into(),
+            table_id: "t1".into(),
+            slot: Slot {
+                day: Day::new(2026, 10, day),
+                start: Time::new(19, 0),
+            },
+            party: 2,
+            guest: guest.into(),
+        }
+    }
+
+    #[test]
+    fn lists_only_the_guests_bookings_oldest_first() {
+        let repository = Rc::new(InMemoryBookingRepository::new(Vec::new()));
+        let late = booking("b1", 12, "Ada");
+        let early = booking("b2", 9, "Ada");
+        repository.save(late.clone());
+        repository.save(booking("b3", 10, "Grace"));
+        repository.save(early.clone());
+        let listed = ListGuestBookings::new(repository).handle("Ada");
+        assert_eq!(listed, vec![early, late]);
+    }
+}
