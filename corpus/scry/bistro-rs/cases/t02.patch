diff --git a/src/booking/queries/find_guest_bookings.rs b/src/booking/queries/find_guest_bookings.rs
new file mode 100644
index 0000000..4656a16
--- /dev/null
+++ b/src/booking/queries/find_guest_bookings.rs
@@ -0,0 +1,70 @@
+//! Every booking under a guest's name, on any day (a query).
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+pub struct FindGuestBookings {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl FindGuestBookings {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> FindGuestBookings {
+        FindGuestBookings { bookings }
+    }
+
+    pub fn handle(&self, guest: &str) -> Vec<Booking> {
+        self.bookings.bookings_for(guest)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Slot, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    #[test]
+    fn lists_the_guests_bookings_on_every_day() {
+        let bookings = Rc::new(InMemoryBookingRepository::new(vec![Table {
+            id: "t1".into(),
+            seats: 4,
+        }]));
+        let first = Booking {
+            id: "b1".into(),
+            table_id: "t1".into(),
+            slot: Slot {
+                day: Day::new(2026, 10, 9),
+                start: Time::new(19, 0),
+            },
+            party: 2,
+            guest: "Ada".into(),
+        };
+        let later = Booking {
+            id: "b2".into(),
+            slot: Slot {
+                day: Day::new(2026, 10, 10),
+                start: Time::new(19, 0),
+            },
+            ..first.clone()
+        };
+        let other = Booking {
+            id: "b3".into(),
+            slot: Slot {
+                day: Day::new(2026, 10, 11),
+                start: Time::new(19, 0),
+            },
+            guest: "Grace".into(),
+            ..first.clone()
+        };
+        bookings.save(later.clone());
+        bookings.save(other);
+        bookings.save(first.clone());
+        assert_eq!(
+            FindGuestBookings::new(bookings).handle("Ada"),
+            vec![first, later]
+        );
+    }
+}
