+//! The manager's summary of a day: bookings, covers and tables with no booking (a query).
+
+use std::rc::Rc;
+
+use crate::booking::models::slot::Day;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DaySummary {
+    pub day: Day,
+    pub bookings: usize,
+    pub covers: u32,
+    pub unbooked_tables: Vec<String>,
+}
+
+pub struct GetDaySummary {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl GetDaySummary {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> GetDaySummary {
+        GetDaySummary { bookings }
+    }
+
+    pub fn handle(&self, day: Day) -> DaySummary {
+        let bookings = self.bookings.bookings_on(day);
+        let unbooked_tables = self
+            .bookings
+            .tables()
+            .into_iter()
+            .filter(|t| !bookings.iter().any(|b| b.table_id == t.id))
+            .map(|t| t.id)
+            .collect();
+        DaySummary {
+            day,
+            bookings: bookings.len(),
+            covers: bookings.iter().map(|b| b.party).sum(),
+            unbooked_tables,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::booking::Booking;
+    use crate::booking::models::slot::{Slot, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    #[test]
+    fn counts_bookings_covers_and_unbooked_tables() {
+        let day = Day::new(2026, 10, 9);
+        let tables = vec![
+            Table {
+                id: "t1".into(),
+                seats: 4,
+            },
+            Table {
+                id: "t2".into(),
+                seats: 2,
+            },
+        ];
+        let bookings = Rc::new(InMemoryBookingRepository::new(tables));
+        let at = |id: &str, hour, party| Booking {
+            id: id.into(),
+            table_id: "t1".into(),
+            slot: Slot {
+                day,
+                start: Time::new(hour, 0),
+            },
+            party,
+            guest: "Ada".into(),
+        };
+        bookings.save(at("b1", 18, 2));
+        bookings.save(at("b2", 20, 3));
+        assert_eq!(
+            GetDaySummary::new(bookings).handle(day),
+            DaySummary {
+                day,
+                bookings: 2,
+                covers: 5,
+                unbooked_tables: vec!["t2".into()],
+            }
+        );
+    }
+}
