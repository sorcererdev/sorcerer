+//! Change the party size of an existing booking.
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ChangePartySizeInput {
+    pub booking_id: String,
+    pub party: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ChangePartySizeFailure {
+    BookingNotFound { reason: String },
+    PartyTooLarge { reason: String },
+}
+
+impl ChangePartySizeFailure {
+    pub fn reason(&self) -> &str {
+        match self {
+            ChangePartySizeFailure::BookingNotFound { reason }
+            | ChangePartySizeFailure::PartyTooLarge { reason } => reason,
+        }
+    }
+}
+
+pub struct ChangePartySize {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl ChangePartySize {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> ChangePartySize {
+        ChangePartySize { bookings }
+    }
+
+    pub fn handle(&self, input: ChangePartySizeInput) -> Result<Booking, ChangePartySizeFailure> {
+        let Some(booking) = self.bookings.booking(&input.booking_id) else {
+            return Err(ChangePartySizeFailure::BookingNotFound {
+                reason: format!("there is no booking {}", input.booking_id),
+            });
+        };
+        let Some(table) = self.bookings.table(&booking.table_id) else {
+            return Err(ChangePartySizeFailure::BookingNotFound {
+                reason: format!("there is no table {}", booking.table_id),
+            });
+        };
+        if input.party >= table.seats {
+            return Err(ChangePartySizeFailure::PartyTooLarge {
+                reason: format!(
+                    "table {} seats {}, not {}",
+                    table.id, table.seats, input.party
+                ),
+            });
+        }
+        let changed = Booking {
+            party: input.party,
+            ..booking
+        };
+        self.bookings.save(changed.clone());
+        Ok(changed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Slot, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    fn command() -> (ChangePartySize, Rc<InMemoryBookingRepository>) {
+        let bookings = Rc::new(InMemoryBookingRepository::new(vec![Table {
+            id: "t1".into(),
+            seats: 4,
+        }]));
+        bookings.save(Booking {
+            id: "b1".into(),
+            table_id: "t1".into(),
+            slot: Slot {
+                day: Day::new(2026, 10, 9),
+                start: Time::new(19, 0),
+            },
+            party: 2,
+            guest: "Ada".into(),
+        });
+        (ChangePartySize::new(bookings.clone()), bookings)
+    }
+
+    fn input(booking_id: &str, party: u32) -> ChangePartySizeInput {
+        ChangePartySizeInput {
+            booking_id: booking_id.into(),
+            party,
+        }
+    }
+
+    #[test]
+    fn changes_the_party_size() {
+        let (change, bookings) = command();
+        let booking = change.handle(input("b1", 3)).unwrap();
+        assert_eq!(booking.party, 3);
+        assert_eq!(bookings.booking("b1"), Some(booking));
+    }
+
+    #[test]
+    fn a_party_larger_than_the_table_is_refused() {
+        let (change, bookings) = command();
+        let result = change.handle(input("b1", 5));
+        assert!(matches!(
+            result,
+            Err(ChangePartySizeFailure::PartyTooLarge { .. })
+        ));
+        assert_eq!(bookings.booking("b1").map(|b| b.party), Some(2));
+    }
+
+    #[test]
+    fn an_unknown_booking_is_not_found() {
+        let (change, _) = command();
+        let result = change.handle(input("b9", 2));
+        assert!(matches!(
+            result,
+            Err(ChangePartySizeFailure::BookingNotFound { .. })
+        ));
+    }
+}
