+//! Find the earliest free slot for a party and hold it for the guest.
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::models::slot::{Day, Slot, Time};
+use crate::booking::ports::booking_repository::BookingRepository;
+use crate::booking::ports::id_generator::IdGenerator;
+
+const FIRST_START: u32 = 17 * 60;
+const LAST_START: u32 = 21 * 60 + 30;
+const STEP: usize = 30;
+
+pub struct NextFreeSlot {
+    bookings: Rc<dyn BookingRepository>,
+    ids: Rc<dyn IdGenerator>,
+}
+
+impl NextFreeSlot {
+    pub fn new(bookings: Rc<dyn BookingRepository>, ids: Rc<dyn IdGenerator>) -> NextFreeSlot {
+        NextFreeSlot { bookings, ids }
+    }
+
+    pub fn handle(&self, day: Day, party: u32, guest: &str) -> Option<Booking> {
+        let mut tables: Vec<_> = self
+            .bookings
+            .tables()
+            .into_iter()
+            .filter(|table| table.seats >= party)
+            .collect();
+        tables.sort_by_key(|table| table.seats);
+        for minutes in (FIRST_START..=LAST_START).step_by(STEP) {
+            let slot = Slot {
+                day,
+                start: Time::new(minutes / 60, minutes % 60),
+            };
+            let free = tables
+                .iter()
+                .find(|table| self.bookings.booking_at(&table.id, &slot).is_none());
+            if let Some(table) = free {
+                let booking = Booking {
+                    id: self.ids.next_id(),
+                    table_id: table.id.clone(),
+                    slot,
+                    party,
+                    guest: guest.into(),
+                };
+                self.bookings.save(booking.clone());
+                return Some(booking);
+            }
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+    use crate::booking::ports::id_generator::in_memory::SequentialIds;
+
+    fn day() -> Day {
+        Day::new(2026, 10, 9)
+    }
+
+    fn query(tables: Vec<Table>) -> NextFreeSlot {
+        NextFreeSlot::new(
+            Rc::new(InMemoryBookingRepository::new(tables)),
+            Rc::new(SequentialIds::default()),
+        )
+    }
+
+    fn table(id: &str, seats: u32) -> Table {
+        Table {
+            id: id.into(),
+            seats,
+        }
+    }
+
+    #[test]
+    fn offers_the_opening_slot_and_holds_it() {
+        let query = query(vec![table("t1", 4)]);
+        let first = query.handle(day(), 2, "Ada").unwrap();
+        assert_eq!(first.slot.start, Time::new(17, 0));
+        let second = query.handle(day(), 2, "Grace").unwrap();
+        assert_eq!(second.slot.start, Time::new(17, 30));
+    }
+
+    #[test]
+    fn a_second_table_takes_the_same_time() {
+        let query = query(vec![table("t1", 4), table("t2", 2)]);
+        let first = query.handle(day(), 2, "Ada").unwrap();
+        let second = query.handle(day(), 2, "Grace").unwrap();
+        assert_eq!(first.table_id, "t2");
+        assert_eq!(second.table_id, "t1");
+        assert_eq!(first.slot, second.slot);
+    }
+
+    #[test]
+    fn nothing_when_no_table_fits() {
+        let query = query(vec![table("t1", 2)]);
+        assert_eq!(query.handle(day(), 5, "Ada"), None);
+    }
+
+    #[test]
+    fn nothing_once_the_evening_is_full() {
+        let query = query(vec![table("t1", 2)]);
+        for _ in 0..10 {
+            assert!(query.handle(day(), 2, "Ada").is_some());
+        }
+        assert_eq!(query.handle(day(), 2, "Grace"), None);
+    }
+}
