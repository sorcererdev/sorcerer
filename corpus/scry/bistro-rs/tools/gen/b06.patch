+fn hold_earliest_slot_input(form: &Form) -> Result<HoldEarliestSlotInput, Response> {
+    Ok(HoldEarliestSlotInput {
+        day: parsed::<Day>(form, "day")?,
+        party: field(form, "party")?
+            .parse()
+            .map_err(|_| Response::new(400, "party is not a number"))?,
+        guest: field(form, "guest")?.to_string(),
+    })
+}
+
+pub fn hold_earliest_slot(form: &Form, app: &App) -> Response {
+    let input = match hold_earliest_slot_input(form) {
+        Ok(input) => input,
+        Err(response) => return response,
+    };
+    match app.hold_earliest_slot.handle(input) {
+        Ok(booking) => Response::new(201, pages::booking_page(&booking)),
+        Err(failure) => Response::new(
+            hold_earliest_slot_status(&failure),
+            pages::failure_page(failure.reason()),
+        ),
+    }
+}
