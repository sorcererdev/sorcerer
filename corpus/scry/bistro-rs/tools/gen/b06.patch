+//! Hold the earliest free slot of a day at a table that fits the party.
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::models::slot::{Day, Slot, Time};
+use crate::booking::ports::booking_repository::BookingRepository;
+use crate::booking::ports::id_generator::IdGenerator;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HoldEarliestSlotInput {
+    pub day: Day,
+    pub party: u32,
+    pub guest: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum HoldEarliestSlotFailure {
+    NoSlotFree { reason: String },
+}
+
+impl HoldEarliestSlotFailure {
+    pub fn reason(&self) -> &str {
+        match self {
+            HoldEarliestSlotFailure::NoSlotFree { reason } => reason,
+        }
+    }
+}
+
+pub struct HoldEarliestSlot {
+    bookings: Rc<dyn BookingRepository>,
+    ids: Rc<dyn IdGenerator>,
+}
+
+impl HoldEarliestSlot {
+    pub fn new(bookings: Rc<dyn BookingRepository>, ids: Rc<dyn IdGenerator>) -> HoldEarliestSlot {
+        HoldEarliestSlot { bookings, ids }
+    }
+
+    pub fn handle(&self, input: HoldEarliestSlotInput) -> Result<Booking, HoldEarliestSlotFailure> {
+        let tables = self.bookings.tables();
+        let taken = self.bookings.bookings_on(input.day);
+        for half_hours in 0..9 {
+            let start = Time::new(17 + half_hours / 2, (half_hours % 2) * 30);
+            let slot = Slot {
+                day: input.day,
+                start,
+            };
+            let free = tables.iter().find(|table| {
+                table.seats >= input.party
+                    && !taken
+                        .iter()
+                        .any(|b| b.table_id == table.id && b.slot == slot)
+            });
+            if let Some(table) = free {
+                let booking = Booking {
+                    id: self.ids.next_id(),
+                    table_id: table.id.clone(),
+                    slot,
+                    party: input.party,
+                    guest: input.guest,
+                };
+                self.bookings.save(booking.clone());
+                return Ok(booking);
+            }
+        }
+        Err(HoldEarliestSlotFailure::NoSlotFree {
+            reason: format!(
+                "no table for {} is free on {}",
+                input.party, input.day
+            ),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+    use crate::booking::ports::id_generator::in_memory::SequentialIds;
+
+    fn command() -> HoldEarliestSlot {
+        let bookings = Rc::new(InMemoryBookingRepository::new(vec![
+            Table {
+                id: "t1".into(),
+                seats: 2,
+            },
+            Table {
+                id: "t2".into(),
+                seats: 4,
+            },
+        ]));
+        HoldEarliestSlot::new(bookings, Rc::new(SequentialIds::default()))
+    }
+
+    fn input(party: u32, guest: &str) -> HoldEarliestSlotInput {
+        HoldEarliestSlotInput {
+            day: Day::new(2026, 10, 9),
+            party,
+            guest: guest.into(),
+        }
+    }
+
+    #[test]
+    fn holds_the_earliest_slot_at_a_table_that_fits() {
+        let booking = command().handle(input(3, "Ada")).unwrap();
+        assert_eq!(booking.table_id, "t2");
+        assert_eq!(booking.slot.start, Time::new(17, 0));
+    }
+
+    #[test]
+    fn the_next_caller_is_offered_the_next_slot() {
+        let hold = command();
+        hold.handle(input(3, "Ada")).unwrap();
+        let booking = hold.handle(input(3, "Grace")).unwrap();
+        assert_eq!(booking.slot.start, Time::new(17, 30));
+    }
+
+    #[test]
+    fn a_party_too_large_for_every_table_has_no_slot() {
+        let result = command().handle(input(9, "Ada"));
+        assert!(matches!(
+            result,
+            Err(HoldEarliestSlotFailure::NoSlotFree { .. })
+        ));
+    }
+}
