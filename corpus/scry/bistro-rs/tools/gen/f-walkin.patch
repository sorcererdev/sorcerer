+pub fn walk_in(form: &Form, app: &App) -> Response {
+    let input = match walk_in_input(form) {
+        Ok(input) => input,
+        Err(response) => return response,
+    };
+    match app.seat_walk_in.handle(input) {
+        Ok(booking) => Response::new(201, pages::booking_page(&booking)),
+        Err(failure) => Response::new(
+            seat_walk_in_status(&failure),
+            pages::failure_page(failure.reason()),
+        ),
+    }
+}
+
+fn walk_in_input(form: &Form) -> Result<SeatWalkInInput, Response> {
+    let party = field(form, "party")?
+        .parse()
+        .map_err(|_| Response::new(400, "party is not a number"))?;
+    Ok(SeatWalkInInput {
+        slot: Slot {
+            day: parsed::<Day>(form, "day")?,
+            start: parsed::<Time>(form, "start")?,
+        },
+        party,
+    })
+}
