+//! Seat a walk-in party at the smallest free table that fits.
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::models::slot::Slot;
+use crate::booking::ports::booking_repository::BookingRepository;
+use crate::booking::ports::id_generator::IdGenerator;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SeatWalkInInput {
+    pub slot: Slot,
+    pub party: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SeatWalkInFailure {
+    NoTableFits { reason: String },
+}
+
+impl SeatWalkInFailure {
+    pub fn reason(&self) -> &str {
+        match self {
+            SeatWalkInFailure::NoTableFits { reason } => reason,
+        }
+    }
+}
+
+pub struct SeatWalkIn {
+    bookings: Rc<dyn BookingRepository>,
+    ids: Rc<dyn IdGenerator>,
+}
+
+impl SeatWalkIn {
+    pub fn new(bookings: Rc<dyn BookingRepository>, ids: Rc<dyn IdGenerator>) -> SeatWalkIn {
+        SeatWalkIn { bookings, ids }
+    }
+
+    pub fn handle(&self, input: SeatWalkInInput) -> Result<Booking, SeatWalkInFailure> {
+        let table = self
+            .bookings
+            .tables()
+            .into_iter()
+            .filter(|t| t.seats >= input.party)
+            .filter(|t| self.bookings.booking_at(&t.id, &input.slot).is_none())
+            .min_by_key(|t| t.seats);
+        let Some(table) = table else {
+            return Err(SeatWalkInFailure::NoTableFits {
+                reason: format!(
+                    "no free table seats {} at {}",
+                    input.party, input.slot.start
+                ),
+            });
+        };
+        let booking = Booking {
+            id: self.ids.next_id(),
+            table_id: table.id,
+            slot: input.slot,
+            party: input.party,
+            guest: "walk-in".into(),
+        };
+        self.bookings.save(booking.clone());
+        Ok(booking)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+    use crate::booking::ports::id_generator::in_memory::SequentialIds;
+
+    fn seven() -> Slot {
+        Slot {
+            day: Day::new(2026, 10, 9),
+            start: Time::new(19, 0),
+        }
+    }
+
+    fn command() -> SeatWalkIn {
+        let bookings = Rc::new(InMemoryBookingRepository::new(vec![
+            Table {
+                id: "big".into(),
+                seats: 6,
+            },
+            Table {
+                id: "small".into(),
+                seats: 2,
+            },
+        ]));
+        SeatWalkIn::new(bookings, Rc::new(SequentialIds::default()))
+    }
+
+    fn input(party: u32) -> SeatWalkInInput {
+        SeatWalkInInput {
+            slot: seven(),
+            party,
+        }
+    }
+
+    #[test]
+    fn seats_at_the_smallest_table_that_fits() {
+        let command = command();
+        assert_eq!(command.handle(input(2)).unwrap().table_id, "small");
+    }
+
+    #[test]
+    fn skips_a_taken_table() {
+        let command = command();
+        command.handle(input(2)).unwrap();
+        assert_eq!(command.handle(input(2)).unwrap().table_id, "big");
+    }
+
+    #[test]
+    fn refuses_when_no_table_fits() {
+        let command = command();
+        assert!(matches!(
+            command.handle(input(7)),
+            Err(SeatWalkInFailure::NoTableFits { .. })
+        ));
+    }
+}
