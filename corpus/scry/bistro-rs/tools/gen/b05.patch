@@ -0,0 +1,178 @@
+//! Swap the tables of two bookings.
+
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SwapTablesInput {
+    pub first_id: String,
+    pub second_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SwapTablesFailure {
+    BookingNotFound { reason: String },
+    PartyTooLarge { reason: String },
+    SlotTaken { reason: String },
+}
+
+impl SwapTablesFailure {
+    pub fn reason(&self) -> &str {
+        match self {
+            SwapTablesFailure::BookingNotFound { reason }
+            | SwapTablesFailure::PartyTooLarge { reason }
+            | SwapTablesFailure::SlotTaken { reason } => reason,
+        }
+    }
+}
+
+pub struct SwapTables {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl SwapTables {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> SwapTables {
+        SwapTables { bookings }
+    }
+
+    pub fn handle(&self, input: SwapTablesInput) -> Result<(Booking, Booking), SwapTablesFailure> {
+        let first = self.find(&input.first_id)?;
+        let second = self.find(&input.second_id)?;
+        let first_moved = Booking {
+            table_id: second.table_id.clone(),
+            ..first.clone()
+        };
+        let second_moved = Booking {
+            table_id: first.table_id.clone(),
+            ..second.clone()
+        };
+        self.check(&first_moved, &second.id)?;
+        self.bookings.save(first_moved.clone());
+        self.bookings.save(second_moved.clone());
+        Ok((first_moved, second_moved))
+    }
+
+    fn find(&self, id: &str) -> Result<Booking, SwapTablesFailure> {
+        self.bookings
+            .booking(id)
+            .ok_or_else(|| SwapTablesFailure::BookingNotFound {
+                reason: format!("there is no booking {id}"),
+            })
+    }
+
+    fn check(&self, moved: &Booking, other_id: &str) -> Result<(), SwapTablesFailure> {
+        let Some(table) = self.bookings.table(&moved.table_id) else {
+            return Err(SwapTablesFailure::BookingNotFound {
+                reason: format!("there is no table {}", moved.table_id),
+            });
+        };
+        if moved.party > table.seats {
+            return Err(SwapTablesFailure::PartyTooLarge {
+                reason: format!(
+                    "table {} seats {}, not {}",
+                    table.id, table.seats, moved.party
+                ),
+            });
+        }
+        match self.bookings.booking_at(&table.id, &moved.slot) {
+            Some(b) if b.id != other_id && b.id != moved.id => Err(SwapTablesFailure::SlotTaken {
+                reason: format!("table {} is booked at {}", table.id, moved.slot.start),
+            }),
+            _ => Ok(()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Slot, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    fn slot(hour: u32) -> Slot {
+        Slot {
+            day: Day::new(2026, 10, 9),
+            start: Time::new(hour, 0),
+        }
+    }
+
+    fn booking(id: &str, table_id: &str, hour: u32, party: u32) -> Booking {
+        Booking {
+            id: id.into(),
+            table_id: table_id.into(),
+            slot: slot(hour),
+            party,
+            guest: "Ada".into(),
+        }
+    }
+
+    fn command(bookings: Vec<Booking>) -> (SwapTables, Rc<InMemoryBookingRepository>) {
+        let repository = Rc::new(InMemoryBookingRepository::new(vec![
+            Table {
+                id: "t1".into(),
+                seats: 4,
+            },
+            Table {
+                id: "t2".into(),
+                seats: 2,
+            },
+            Table {
+                id: "t3".into(),
+                seats: 4,
+            },
+        ]));
+        for b in bookings {
+            repository.save(b);
+        }
+        (SwapTables::new(repository.clone()), repository)
+    }
+
+    fn input(first: &str, second: &str) -> SwapTablesInput {
+        SwapTablesInput {
+            first_id: first.into(),
+            second_id: second.into(),
+        }
+    }
+
+    #[test]
+    fn swaps_the_tables() {
+        let (swap, repository) = command(vec![booking("b1", "t1", 19, 2), booking("b2", "t2", 19, 2)]);
+        swap.handle(input("b1", "b2")).unwrap();
+        assert_eq!(repository.booking("b1").unwrap().table_id, "t2");
+        assert_eq!(repository.booking("b2").unwrap().table_id, "t1");
+    }
+
+    #[test]
+    fn an_unknown_booking_is_not_found() {
+        let (swap, _) = command(vec![booking("b1", "t1", 19, 2)]);
+        let result = swap.handle(input("b1", "b9"));
+        assert!(matches!(
+            result,
+            Err(SwapTablesFailure::BookingNotFound { .. })
+        ));
+    }
+
+    #[test]
+    fn a_party_too_large_for_the_new_table_is_refused() {
+        let (swap, _) = command(vec![booking("b1", "t1", 19, 4), booking("b2", "t2", 19, 2)]);
+        let result = swap.handle(input("b1", "b2"));
+        assert!(matches!(
+            result,
+            Err(SwapTablesFailure::PartyTooLarge { .. })
+        ));
+    }
+
+    #[test]
+    fn a_slot_taken_on_the_new_table_is_refused() {
+        let (swap, _) = command(vec![
+            booking("b1", "t1", 19, 2),
+            booking("b2", "t2", 20, 2),
+            booking("b3", "t2", 19, 2),
+        ]);
+        let result = swap.handle(input("b1", "b2"));
+        assert!(matches!(result, Err(SwapTablesFailure::SlotTaken { .. })));
+    }
+}
