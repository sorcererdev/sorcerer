new file mode 100644
index 0000000..96a846c
--- /dev/null
+++ b/src/booking/ports/clock/system.rs
@@ -0,0 +1,18 @@
+//! The Clock for real use: today's date from the system time.
+
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::booking::models::slot::Day;
+use crate::booking::ports::clock::Clock;
+
+pub struct SystemClock;
+
+impl Clock for SystemClock {
+    fn today(&self) -> Day {
+        let seconds = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_secs())
+            .unwrap_or_default();
+        Day::from_days_since_epoch((seconds / 86_400) as i64)
+    }
+}
