@@ -0,0 +1,12 @@
+//! A Clock in memory: always the day it was given, for tests and demos.
+
+use crate::booking::models::slot::Day;
+use crate::booking::ports::clock::Clock;
+
+pub struct FixedClock(pub Day);
+
+impl Clock for FixedClock {
+    fn today(&self) -> Day {
+        self.0
+    }
+}
