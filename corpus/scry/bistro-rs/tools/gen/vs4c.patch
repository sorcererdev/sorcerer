@@ -80,16 +80,33 @@ impl BookingRepository for FileBookingRepository {
             .append(true)
             .open(&self.path)
             .unwrap_or_else(|e| panic!("cannot open {}: {e}", self.path.display()));
-        let line = format!(
-            "{}\t{}\t{}\t{}\t{}\t{}\n",
-            booking.id,
-            booking.table_id,
-            booking.slot.day,
-            booking.slot.start,
-            booking.party,
-            booking.guest
-        );
-        file.write_all(line.as_bytes())
+        file.write_all(format_line(&booking).as_bytes())
             .unwrap_or_else(|e| panic!("cannot write {}: {e}", self.path.display()));
     }
+
+    fn booking(&self, booking_id: &str) -> Option<Booking> {
+        self.all().into_iter().find(|b| b.id == booking_id)
+    }
+
+    fn update(&self, booking: Booking) {
+        let text: String = self
+            .all()
+            .into_iter()
+            .map(|b| if b.id == booking.id { format_line(&booking) } else { format_line(&b) })
+            .collect();
+        fs::write(&self.path, text)
+            .unwrap_or_else(|e| panic!("cannot write {}: {e}", self.path.display()));
+    }
+}
+
+fn format_line(booking: &Booking) -> String {
+    format!(
+        "{}\t{}\t{}\t{}\t{}\t{}\n",
+        booking.id,
+        booking.table_id,
+        booking.slot.day,
+        booking.slot.start,
+        booking.party,
+        booking.guest
+    )
 }
diff --git a/src/booking/ports/booking_repository/in_memory.rs b/src/booking/ports/booking_repository/in_memory.rs
index 27ca418..965fb51 100644
--- a/src/booking/ports/booking_repository/in_memory.rs
+++ b/src/booking/ports/booking_repository/in_memory.rs
@@ -50,4 +50,23 @@ impl BookingRepository for InMemoryBookingRepository {
     fn save(&self, booking: Booking) {
         self.bookings.borrow_mut().push(booking);
     }
+
+    fn booking(&self, booking_id: &str) -> Option<Booking> {
+        self.bookings
+            .borrow()
+            .iter()
+            .find(|b| b.id == booking_id)
+            .cloned()
+    }
+
+    fn update(&self, booking: Booking) {
+        if let Some(existing) = self
+            .bookings
+            .borrow_mut()
+            .iter_mut()
+            .find(|b| b.id == booking.id)
+        {
+            *existing = booking;
+        }
+    }
 }
