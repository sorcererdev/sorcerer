+
+    #[test]
+    fn updates_a_booking_by_id() {
+        for repository in repositories("updates") {
+            let booking = Booking {
+                id: "b1".into(),
+                table_id: "t1".into(),
+                slot: seven(),
+                party: 2,
+                guest: "Ada".into(),
+            };
+            repository.save(booking.clone());
+            assert_eq!(repository.booking("b1"), Some(booking.clone()));
+            assert_eq!(repository.booking("b9"), None);
+            let moved = Booking {
+                table_id: "t2".into(),
+                ..booking
+            };
+            repository.update(moved.clone());
+            assert_eq!(repository.booking("b1"), Some(moved.clone()));
+            assert_eq!(repository.booking_at("t1", &seven()), None);
+            assert_eq!(repository.booking_at("t2", &seven()), Some(moved));
+        }
+    }
 }
