index 0000000..4193baf
--- /dev/null
+++ b/src/booking/commands/swap_tables.rs
@@ -0,0 +1,178 @@
+use std::rc::Rc;
+
+use crate::booking::models::booking::Booking;
+use crate::booking::ports::booking_repository::BookingRepository;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SwapTablesInput {
+    pub first_booking_id: String,
+    pub second_booking_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SwapTablesFailure {
+    BookingNotFound { reason: String },
+    SameBooking { reason: String },
+    PartyTooLarge { reason: String },
+    SlotTaken { reason: String },
+}
+
+impl SwapTablesFailure {
+    pub fn reason(&self) -> &str {
+        match self {
+            SwapTablesFailure::BookingNotFound { reason }
+            | SwapTablesFailure::SameBooking { reason }
+            | SwapTablesFailure::PartyTooLarge { reason }
+            | SwapTablesFailure::SlotTaken { reason } => reason,
+        }
+    }
+}
+
+pub struct SwapTables {
+    bookings: Rc<dyn BookingRepository>,
+}
+
+impl SwapTables {
+    pub fn new(bookings: Rc<dyn BookingRepository>) -> SwapTables {
+        SwapTables { bookings }
+    }
+
+    pub fn handle(&self, input: SwapTablesInput) -> Result<(Booking, Booking), SwapTablesFailure> {
+        if input.first_booking_id == input.second_booking_id {
+            return Err(SwapTablesFailure::SameBooking {
+                reason: "a booking cannot be swapped with itself".to_string(),
+            });
+        }
+        let first = self.find(&input.first_booking_id)?;
+        let second = self.find(&input.second_booking_id)?;
+        let moved_first = Booking {
+            table_id: second.table_id.clone(),
+            ..first.clone()
+        };
+        let moved_second = Booking {
+            table_id: first.table_id.clone(),
+            ..second.clone()
+        };
+        self.check(&moved_first, &second.id)?;
+        self.check(&moved_second, &first.id)?;
+        self.bookings.update(moved_first.clone());
+        self.bookings.update(moved_second.clone());
+        Ok((moved_first, moved_second))
+    }
+
+    fn find(&self, booking_id: &str) -> Result<Booking, SwapTablesFailure> {
+        self.bookings
+            .booking(booking_id)
+            .ok_or_else(|| SwapTablesFailure::BookingNotFound {
+                reason: format!("there is no booking {booking_id}"),
+            })
+    }
+
+    fn check(&self, moved: &Booking, other_id: &str) -> Result<(), SwapTablesFailure> {
+        let Some(table) = self.bookings.table(&moved.table_id) else {
+            return Err(SwapTablesFailure::BookingNotFound {
+                reason: format!("there is no table {}", moved.table_id),
+            });
+        };
+        if moved.party > table.seats {
+            return Err(SwapTablesFailure::PartyTooLarge {
+                reason: format!(
+                    "table {} seats {}, not {}",
+                    table.id, table.seats, moved.party
+                ),
+            });
+        }
+        match self.bookings.booking_at(&table.id, &moved.slot) {
+            Some(existing) if existing.id != other_id => Err(SwapTablesFailure::SlotTaken {
+                reason: format!("table {} is booked at {}", table.id, moved.slot.start),
+            }),
+            _ => Ok(()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::booking::models::slot::{Day, Slot, Time};
+    use crate::booking::models::table::Table;
+    use crate::booking::ports::booking_repository::in_memory::InMemoryBookingRepository;
+
+    fn seven() -> Slot {
+        Slot {
+            day: Day::new(2026, 10, 9),
+            start: Time::new(19, 0),
+        }
+    }
+
+    fn booking(id: &str, table_id: &str, party: u32) -> Booking {
+        Booking {
+            id: id.into(),
+            table_id: table_id.into(),
+            slot: seven(),
+            party,
+            guest: "Ada".into(),
+        }
+    }
+
+    fn command(first_party: u32) -> (SwapTables, Rc<InMemoryBookingRepository>) {
+        let bookings = Rc::new(InMemoryBookingRepository::new(vec![
+            Table {
+                id: "t1".into(),
+                seats: 4,
+            },
+            Table {
+                id: "t2".into(),
+                seats: 2,
+            },
+        ]));
+        bookings.save(booking("b1", "t1", first_party));
+        bookings.save(booking("b2", "t2", 2));
+        (SwapTables::new(bookings.clone()), bookings)
+    }
+
+    fn input(first: &str, second: &str) -> SwapTablesInput {
+        SwapTablesInput {
+            first_booking_id: first.into(),
+            second_booking_id: second.into(),
+        }
+    }
+
+    #[test]
+    fn swaps_two_bookings_tables() {
+        let (swap, bookings) = command(2);
+        let (first, second) = swap.handle(input("b1", "b2")).unwrap();
+        assert_eq!(first, booking("b1", "t2", 2));
+        assert_eq!(second, booking("b2", "t1", 2));
+        assert_eq!(bookings.booking("b1"), Some(first));
+        assert_eq!(bookings.booking("b2"), Some(second));
+    }
+
+    #[test]
+    fn a_party_larger_than_the_new_table_is_refused() {
+        let (swap, bookings) = command(4);
+        let result = swap.handle(input("b1", "b2"));
+        assert!(matches!(
+            result,
+            Err(SwapTablesFailure::PartyTooLarge { .. })
+        ));
+        assert_eq!(bookings.booking("b1"), Some(booking("b1", "t1", 4)));
+    }
+
+    #[test]
+    fn an_unknown_booking_is_not_found() {
+        let (swap, _) = command(2);
+        let result = swap.handle(input("b1", "b9"));
+        assert!(matches!(
+            result,
+            Err(SwapTablesFailure::BookingNotFound { .. })
+        ));
+    }
+
+    #[test]
+    fn a_booking_cannot_swap_with_itself() {
+        let (swap, _) = command(2);
+        let result = swap.handle(input("b1", "b1"));
+        assert!(matches!(result, Err(SwapTablesFailure::SameBooking { .. })));
+    }
+}
