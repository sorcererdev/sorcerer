+fn create_weekly_booking_status(failure: &CreateWeeklyBookingFailure) -> u16 {
+    match failure {
+        CreateWeeklyBookingFailure::NoWeeks { .. } => 422,
+        CreateWeeklyBookingFailure::SlotTaken { .. } => 409,
+        CreateWeeklyBookingFailure::PartyTooLarge { .. } => 422,
+        CreateWeeklyBookingFailure::TableNotFound { .. } => 404,
+    }
+}
+
+pub fn create_weekly_booking(form: &Form, app: &App) -> Response {
+    let input = match create_booking_input(form).and_then(|base| {
+        let weeks = field(form, "weeks")?
+            .parse()
+            .map_err(|_| Response::new(400, "weeks is not a number"))?;
+        Ok(CreateWeeklyBookingInput {
+            table_id: base.table_id,
+            slot: base.slot,
+            weeks,
+            party: base.party,
+            guest: base.guest,
+        })
+    }) {
+        Ok(input) => input,
+        Err(response) => return response,
+    };
+    match app.create_weekly_booking.handle(input) {
+        Ok(bookings) => {
+            let lines: Vec<String> = bookings.iter().map(pages::booking_page).collect();
+            Response::new(201, lines.join("\n"))
+        }
+        Err(failure) => Response::new(
+            create_weekly_booking_status(&failure),
+            pages::failure_page(failure.reason()),
+        ),
+    }
+}
