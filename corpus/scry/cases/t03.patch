@@ -0,0 +1,16 @@
+from datetime import date, time
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.queries.get_guest_bookings import GetGuestBookings
+
+
+def test_lists_a_guests_bookings_on_any_day() -> None:
+    bookings = InMemoryBookingRepository()
+    later = Booking(id="b1", table_id="t1", slot=Slot(day=date(2026, 10, 10), start=time(19, 0)), party=2, guest="Ada")
+    earlier = Booking(id="b2", table_id="t2", slot=Slot(day=date(2026, 10, 9), start=time(18, 0)), party=3, guest="Ada")
+    other = Booking(id="b3", table_id="t1", slot=Slot(day=date(2026, 10, 9), start=time(19, 0)), party=2, guest="Grace")
+    for booking in (later, earlier, other):
+        bookings.save(booking)
+    assert GetGuestBookings(bookings=bookings).handle("Ada") == [earlier, later]
