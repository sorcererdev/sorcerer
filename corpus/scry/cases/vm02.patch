+from datetime import date, time
+from pathlib import Path
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.sqlite_booking_repository import SqliteBookingRepository
+from bistro.booking.queries.get_guest_bookings import GetGuestBookings
+
+
+def test_lists_a_guests_bookings_oldest_first(tmp_path: Path) -> None:
+    path = str(tmp_path / "bistro.sqlite3")
+    bookings = SqliteBookingRepository(path)
+    bookings.add_tables([Table(id="t1", seats=4)])
+    later = Booking(id="b1", table_id="t1", slot=Slot(day=date(2026, 10, 16), start=time(19, 0)), party=2, guest="Ada")
+    earlier = Booking(id="b2", table_id="t1", slot=Slot(day=date(2026, 10, 9), start=time(19, 0)), party=2, guest="Ada")
+    other = Booking(id="b3", table_id="t1", slot=Slot(day=date(2026, 10, 9), start=time(20, 0)), party=2, guest="Grace")
+    for booking in (later, earlier, other):
+        bookings.save(booking)
+    assert GetGuestBookings(db_path=path).handle("Ada") == [earlier, later]
