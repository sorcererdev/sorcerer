+"""Every booking a guest has made, across all days, oldest first (a query)."""
+
+import sqlite3
+from datetime import date, time
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+
+
+class GetGuestBookings:
+    def __init__(self, db_path: str) -> None:
+        self.db_path = db_path
+
+    def handle(self, guest: str) -> list[Booking]:
+        with sqlite3.connect(self.db_path) as db:
+            rows: list[tuple[str, str, str, str, int, str]] = db.execute(
+                "select id, table_id, day, start, party, guest from bookings where guest = ? order by day, start",
+                (guest,),
+            ).fetchall()
+        return [
+            Booking(id=i, table_id=t, slot=Slot(day=date.fromisoformat(d), start=time.fromisoformat(s)), party=p, guest=g)
+            for i, t, d, s, p, g in rows
+        ]
