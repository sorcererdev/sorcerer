+def test_a_guest_cannot_book_twice_in_a_day() -> None:
+    create, _ = command()
+    create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="Ada"))
+    later = Slot(day=SEVEN.day, start=time(21, 0))
+    result = create.handle(CreateBookingInput(table_id="t1", slot=later, party=2, guest="Ada"))
+    assert isinstance(result, GuestAlreadyBooked)
