+
+    def update(self, booking: Booking) -> None:
+        self._db.execute(
+            "update bookings set table_id = ?, day = ?, start = ?, party = ?, guest = ? where id = ?",
+            (booking.table_id, booking.slot.day.isoformat(), booking.slot.start.isoformat(), booking.party, booking.guest, booking.id),
