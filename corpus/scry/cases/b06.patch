+"""Swap the tables of two bookings."""
+
+from dataclasses import dataclass, replace
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.shared.result import Ok
+
+
+@dataclass(frozen=True)
+class SwapTablesInput:
+    first_id: str
+    second_id: str
+
+
+@dataclass(frozen=True)
+class BookingNotFound:
+    reason: str
+
+
+@dataclass(frozen=True)
+class PartyTooLarge:
+    reason: str
+
+
+@dataclass(frozen=True)
+class SlotTaken:
+    reason: str
+
+
+type SwapTablesFailure = (
+    BookingNotFound
+    | PartyTooLarge
+    | SlotTaken
+)
+
+type SwapTablesOutput = Ok[tuple[Booking, Booking]] | SwapTablesFailure
+
+
+class SwapTables:
+    def __init__(self, bookings: BookingRepository) -> None:
+        self.bookings = bookings
+
+    def handle(self, input: SwapTablesInput) -> SwapTablesOutput:
+        first = self.bookings.booking(input.first_id)
+        if first is None:
+            return BookingNotFound(f"there is no booking {input.first_id}")
+        second = self.bookings.booking(input.second_id)
+        if second is None:
+            return BookingNotFound(f"there is no booking {input.second_id}")
+        for booking, other in ((first, second), (second, first)):
+            table = self.bookings.table(booking.table_id)
+            if table is not None and booking.party > table.seats:
+                return PartyTooLarge(f"table {table.id} seats {table.seats}, not {booking.party}")
+            taken = self.bookings.booking_at(other.table_id, booking.slot)
+            if taken is not None and taken.id != other.id:
+                return SlotTaken(f"table {other.table_id} is booked at {booking.slot.start:%H:%M}")
+        swapped_first = replace(first, table_id=second.table_id)
+        swapped_second = replace(second, table_id=first.table_id)
+        self.bookings.update(swapped_first)
+        self.bookings.update(swapped_second)
+        return Ok((swapped_first, swapped_second))
diff --git a/src/bistro/booking/commands/swap_tables__test.py b/src/bistro/booking/commands/swap_tables__test.py
new file mode 100644
index 0000000..8f208c2
--- /dev/null
+++ b/src/bistro/booking/commands/swap_tables__test.py
@@ -0,0 +1,50 @@
+from datetime import date, time
+
+from bistro.booking.commands.swap_tables import (
+    BookingNotFound,
+    SlotTaken,
+    SwapTables,
+    SwapTablesInput,
+)
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.shared.result import Ok
+
+SEVEN = Slot(day=date(2026, 10, 9), start=time(19, 0))
+EIGHT = Slot(day=date(2026, 10, 9), start=time(20, 0))
+
+
+def command(*existing: Booking) -> tuple[SwapTables, InMemoryBookingRepository]:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=4), Table(id="t2", seats=2)])
+    for booking in existing:
+        bookings.save(booking)
+    return SwapTables(bookings=bookings), bookings
+
+
+def test_swaps_the_tables_of_two_bookings() -> None:
+    swap, bookings = command(
+        Booking(id="b1", table_id="t1", slot=SEVEN, party=2, guest="Ada"),
+        Booking(id="b2", table_id="t2", slot=SEVEN, party=2, guest="Grace"),
+    )
+    result = swap.handle(SwapTablesInput(first_id="b1", second_id="b2"))
+    assert isinstance(result, Ok)
+    assert bookings.booking("b1") == Booking(id="b1", table_id="t2", slot=SEVEN, party=2, guest="Ada")
+    assert bookings.booking("b2") == Booking(id="b2", table_id="t1", slot=SEVEN, party=2, guest="Grace")
+
+
+def test_an_unknown_booking_is_not_found() -> None:
+    swap, _ = command(Booking(id="b1", table_id="t1", slot=SEVEN, party=2, guest="Ada"))
+    result = swap.handle(SwapTablesInput(first_id="b1", second_id="b9"))
+    assert isinstance(result, BookingNotFound)
+
+
+def test_a_slot_taken_on_the_new_table_is_refused() -> None:
+    swap, _ = command(
+        Booking(id="b1", table_id="t1", slot=SEVEN, party=2, guest="Ada"),
+        Booking(id="b2", table_id="t2", slot=EIGHT, party=2, guest="Grace"),
+        Booking(id="b3", table_id="t2", slot=SEVEN, party=2, guest="Alan"),
+    )
+    result = swap.handle(SwapTablesInput(first_id="b1", second_id="b2"))
+    assert isinstance(result, SlotTaken)
