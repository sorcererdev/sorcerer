@@ -0,0 +1,11 @@
+"""Clock fixed on a given day, for tests and demos."""
+
+from datetime import date
+
+
+class InMemoryClock:
+    def __init__(self, today: date) -> None:
+        self._today = today
+
+    def today(self) -> date:
+        return self._today
