@@ -0,0 +1,45 @@
+"""Seat a walk-in party at the smallest free table that fits."""
+
+from dataclasses import dataclass
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.booking.ports.id_generator.id_generator import IdGenerator
+from bistro.shared.result import Ok
+
+
+@dataclass(frozen=True)
+class SeatWalkInInput:
+    slot: Slot
+    party: int
+    guest: str
+
+
+@dataclass(frozen=True)
+class NoTableFree:
+    reason: str
+
+
+type SeatWalkInFailure = (
+    NoTableFree
+)
+
+type SeatWalkInOutput = Ok[Booking] | SeatWalkInFailure
+
+
+class SeatWalkIn:
+    def __init__(self, bookings: BookingRepository, ids: IdGenerator) -> None:
+        self.bookings = bookings
+        self.ids = ids
+
+    def handle(self, input: SeatWalkInInput) -> SeatWalkInOutput:
+        fitting = sorted((t for t in self.bookings.tables() if t.seats >= input.party), key=lambda t: t.seats)
+        for table in fitting:
+            if self.bookings.booking_at(table.id, input.slot) is None:
+                booking = Booking(
+                    id=self.ids.next_id(), table_id=table.id, slot=input.slot, party=input.party, guest=input.guest
+                )
+                self.bookings.save(booking)
+                return Ok(booking)
+        return NoTableFree(f"no table for {input.party} is free at {input.slot.start:%H:%M}")
diff --git a/src/bistro/booking/commands/seat_walk_in__test.py b/src/bistro/booking/commands/seat_walk_in__test.py
new file mode 100644
index 0000000..484264d
--- /dev/null
+++ b/src/bistro/booking/commands/seat_walk_in__test.py
@@ -0,0 +1,43 @@
+from datetime import date, time
+
+from bistro.booking.commands.create_booking import CreateBooking, CreateBookingInput
+from bistro.booking.commands.seat_walk_in import NoTableFree, SeatWalkIn, SeatWalkInInput
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.ports.id_generator.in_memory_id_generator import InMemoryIdGenerator
+from bistro.shared.result import Ok
+
+SEVEN = Slot(day=date(2026, 10, 9), start=time(19, 0))
+
+
+def command() -> tuple[SeatWalkIn, InMemoryBookingRepository]:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t6", seats=6), Table(id="t2", seats=2), Table(id="t4", seats=4)])
+    seat = SeatWalkIn(
+        bookings=bookings,
+        ids=InMemoryIdGenerator(),
+    )
+    return seat, bookings
+
+
+def test_seats_at_the_smallest_table_that_fits() -> None:
+    seat, _ = command()
+    result = seat.handle(SeatWalkInInput(slot=SEVEN, party=3, guest="Ada"))
+    assert result == Ok(Booking(id="b1", table_id="t4", slot=SEVEN, party=3, guest="Ada"))
+
+
+def test_skips_a_taken_table() -> None:
+    seat, bookings = command()
+    CreateBooking(bookings=bookings, ids=InMemoryIdGenerator()).handle(
+        CreateBookingInput(table_id="t4", slot=SEVEN, party=3, guest="Grace")
+    )
+    result = seat.handle(SeatWalkInInput(slot=SEVEN, party=3, guest="Ada"))
+    assert isinstance(result, Ok)
+    assert result.value.table_id == "t6"
+
+
+def test_no_free_table_is_refused() -> None:
+    seat, _ = command()
+    result = seat.handle(SeatWalkInInput(slot=SEVEN, party=7, guest="Ada"))
+    assert isinstance(result, NoTableFree)
