@@ -0,0 +1,25 @@
+"""The manager's numbers for a day: bookings, covers and tables never booked (a query)."""
+
+from dataclasses import dataclass
+from datetime import date
+
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+
+
+@dataclass(frozen=True)
+class DaySummary:
+    day: date
+    bookings: int
+    covers: int
+    empty_tables: int
+
+
+class GetDaySummary:
+    def __init__(self, bookings: BookingRepository) -> None:
+        self.bookings = bookings
+
+    def handle(self, day: date) -> DaySummary:
+        booked = self.bookings.bookings_on(day)
+        booked_tables = {b.table_id for b in booked}
+        empty = [t for t in self.bookings.tables() if t.id not in booked_tables]
+        return DaySummary(day=day, bookings=len(booked), covers=sum(b.party for b in booked), empty_tables=len(empty))
diff --git a/src/bistro/booking/queries/get_day_summary__test.py b/src/bistro/booking/queries/get_day_summary__test.py
new file mode 100644
index 0000000..6bbf047
--- /dev/null
+++ b/src/bistro/booking/queries/get_day_summary__test.py
@@ -0,0 +1,20 @@
+from datetime import date, time
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.queries.get_day_summary import DaySummary, GetDaySummary
+
+DAY = date(2026, 10, 9)
+
+
+def test_counts_bookings_covers_and_tables_with_no_booking() -> None:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=4), Table(id="t2", seats=4), Table(id="t3", seats=2)])
+    bookings.save(Booking(id="b1", table_id="t1", slot=Slot(day=DAY, start=time(19, 0)), party=2, guest="Ada"))
+    bookings.save(Booking(id="b2", table_id="t1", slot=Slot(day=DAY, start=time(20, 0)), party=3, guest="Grace"))
+    bookings.save(Booking(id="b3", table_id="t2", slot=Slot(day=date(2026, 10, 10), start=time(19, 0)), party=4, guest="Alan"))
+    summary = GetDaySummary(
+        bookings=bookings,
+    ).handle(DAY)
+    assert summary == DaySummary(day=DAY, bookings=2, covers=5, empty_tables=2)
