@@ -25,5 +25,11 @@ class InMemoryBookingRepository:
     def bookings_on(self, day: date) -> list[Booking]:
         return [b for b in self._bookings if b.slot.day == day]
 
+    def booking(self, booking_id: str) -> Booking | None:
+        return next((b for b in self._bookings if b.id == booking_id), None)
+
     def save(self, booking: Booking) -> None:
         self._bookings.append(booking)
+
+    def delete(self, booking_id: str) -> None:
+        self._bookings = [b for b in self._bookings if b.id != booking_id]
