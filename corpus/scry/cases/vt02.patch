@@ -0,0 +1,50 @@
+"""Put a guest's party on a day's waitlist."""
+
+from dataclasses import dataclass
+from datetime import date
+
+from bistro.booking.models.waitlist_entry import WaitlistEntry
+from bistro.booking.ports.waitlist_repository.waitlist_repository import WaitlistRepository
+from bistro.shared.result import Ok
+
+MAX_PARTIES_PER_DAY = 10
+
+
+@dataclass(frozen=True)
+class JoinWaitlistInput:
+    day: date
+    party: int
+    guest: str
+
+
+@dataclass(frozen=True)
+class AlreadyOnWaitlist:
+    reason: str
+
+
+@dataclass(frozen=True)
+class WaitlistFull:
+    reason: str
+
+
+type JoinWaitlistFailure = (
+    AlreadyOnWaitlist
+    | WaitlistFull
+)
+
+type JoinWaitlistOutput = Ok[WaitlistEntry] | JoinWaitlistFailure
+
+
+class JoinWaitlist:
+    def __init__(self, waitlist: WaitlistRepository) -> None:
+        self.waitlist = waitlist
+
+    def handle(self, input: JoinWaitlistInput) -> JoinWaitlistOutput:
+        entries = self.waitlist.entries_on(input.day)
+        if any(e.guest == input.guest for e in entries):
+            return AlreadyOnWaitlist(f"{input.guest} is already on the waitlist for {input.day:%Y-%m-%d}")
+        if len(entries) >= MAX_PARTIES_PER_DAY:
+            return WaitlistFull(f"the waitlist for {input.day:%Y-%m-%d} is full")
+        entry = WaitlistEntry(day=input.day, party=input.party, guest=input.guest)
+        self.waitlist.save(entry)
+        return Ok(entry)
diff --git a/src/bistro/booking/commands/join_waitlist__test.py b/src/bistro/booking/commands/join_waitlist__test.py
new file mode 100644
index 0000000..130052c
--- /dev/null
+++ b/src/bistro/booking/commands/join_waitlist__test.py
@@ -0,0 +1,50 @@
+from datetime import date
+
+from bistro.booking.commands.join_waitlist import (
+    AlreadyOnWaitlist,
+    JoinWaitlist,
+    JoinWaitlistInput,
+    WaitlistFull,
+)
+from bistro.booking.models.waitlist_entry import WaitlistEntry
+from bistro.booking.ports.waitlist_repository.in_memory_waitlist_repository import InMemoryWaitlistRepository
+from bistro.shared.result import Ok
+
+DAY = date(2026, 10, 9)
+
+
+def command() -> tuple[JoinWaitlist, InMemoryWaitlistRepository]:
+    waitlist = InMemoryWaitlistRepository()
+    join = JoinWaitlist(
+        waitlist=waitlist,
+    )
+    return join, waitlist
+
+
+def test_joins_the_waitlist() -> None:
+    join, waitlist = command()
+    result = join.handle(JoinWaitlistInput(day=DAY, party=2, guest="Ada"))
+    assert result == Ok(WaitlistEntry(day=DAY, party=2, guest="Ada"))
+    assert waitlist.entries_on(DAY) == [WaitlistEntry(day=DAY, party=2, guest="Ada")]
+
+
+def test_the_same_guest_cannot_join_twice_for_a_day() -> None:
+    join, _ = command()
+    join.handle(JoinWaitlistInput(day=DAY, party=2, guest="Ada"))
+    result = join.handle(JoinWaitlistInput(day=DAY, party=4, guest="Ada"))
+    assert isinstance(result, AlreadyOnWaitlist)
+
+
+def test_the_same_guest_can_join_another_day() -> None:
+    join, _ = command()
+    join.handle(JoinWaitlistInput(day=DAY, party=2, guest="Ada"))
+    result = join.handle(JoinWaitlistInput(day=date(2026, 10, 10), party=2, guest="Ada"))
+    assert isinstance(result, Ok)
+
+
+def test_a_day_holds_at_most_ten_parties() -> None:
+    join, _ = command()
+    for i in range(10):
+        join.handle(JoinWaitlistInput(day=DAY, party=2, guest=f"guest{i}"))
+    result = join.handle(JoinWaitlistInput(day=DAY, party=2, guest="Ada"))
+    assert isinstance(result, WaitlistFull)
