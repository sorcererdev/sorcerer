@@ -0,0 +1,16 @@
+"""A WaitlistRepository in memory: for tests and the first run."""
+
+from datetime import date
+
+from bistro.booking.models.waitlist_entry import WaitlistEntry
+
+
+class InMemoryWaitlistRepository:
+    def __init__(self) -> None:
+        self._entries: list[WaitlistEntry] = []
+
+    def entries_on(self, day: date) -> list[WaitlistEntry]:
+        return [e for e in self._entries if e.day == day]
+
+    def save(self, entry: WaitlistEntry) -> None:
+        self._entries.append(entry)
diff --git a/src/bistro/booking/ports/waitlist_repository/sqlite_waitlist_repository.py b/src/bistro/booking/ports/waitlist_repository/sqlite_waitlist_repository.py
