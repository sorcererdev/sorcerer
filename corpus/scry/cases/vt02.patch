@@ -0,0 +1,31 @@
+"""A WaitlistRepository in SQLite (stdlib sqlite3)."""
+
+import sqlite3
+from datetime import date
+
+from bistro.booking.models.waitlist_entry import WaitlistEntry
+
+SCHEMA = """
+create table if not exists waitlist (
+    day text not null, party integer not null, guest text not null
+);
+"""
+
+
+class SqliteWaitlistRepository:
+    def __init__(self, path: str) -> None:
+        self._db = sqlite3.connect(path, check_same_thread=False)
+        self._db.executescript(SCHEMA)
+
+    def entries_on(self, day: date) -> list[WaitlistEntry]:
+        rows: list[tuple[str, int, str]] = self._db.execute(
+            "select day, party, guest from waitlist where day = ? order by rowid", (day.isoformat(),)
+        ).fetchall()
+        return [WaitlistEntry(day=date.fromisoformat(d), party=p, guest=g) for d, p, g in rows]
+
+    def save(self, entry: WaitlistEntry) -> None:
+        self._db.execute(
+            "insert into waitlist (day, party, guest) values (?, ?, ?)",
+            (entry.day.isoformat(), entry.party, entry.guest),
+        )
+        self._db.commit()
