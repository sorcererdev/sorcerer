+++ b/src/bistro/booking/commands/create_booking.py
@@ -32,10 +32,16 @@ class TableNotFound:
     reason: str
 
 
+@dataclass(frozen=True)
+class InvalidGuestName:
+    reason: str
+
+
 type CreateBookingFailure = (
     SlotTaken
     | PartyTooLarge
     | TableNotFound
+    | InvalidGuestName
 )
 
 type CreateBookingOutput = Ok[Booking] | CreateBookingFailure
@@ -47,6 +53,10 @@ class CreateBooking:
         self.ids = ids
 
     def handle(self, input: CreateBookingInput) -> CreateBookingOutput:
+        if not input.guest.strip():
+            return InvalidGuestName("the guest name is blank")
+        if len(input.guest) > 60:
+            return InvalidGuestName("the guest name is longer than 60 characters")
         table = self.bookings.table(input.table_id)
         if table is None:
             return TableNotFound(f"there is no table {input.table_id}")
