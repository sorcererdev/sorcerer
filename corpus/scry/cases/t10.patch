     SlotTaken,
     TableNotFound,
@@ -47,6 +48,24 @@ def test_a_party_larger_than_the_table_is_refused() -> None:
     assert isinstance(result, PartyTooLarge)
 
 
+def test_a_blank_guest_name_is_refused() -> None:
+    create, _ = command()
+    result = create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="   "))
+    assert isinstance(result, InvalidGuestName)
+
+
+def test_a_guest_name_over_60_characters_is_refused() -> None:
+    create, _ = command()
+    result = create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="a" * 61))
+    assert isinstance(result, InvalidGuestName)
+
+
+def test_a_guest_name_of_60_characters_is_accepted() -> None:
+    create, _ = command()
+    result = create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="a" * 60))
+    assert isinstance(result, Ok)
+
+
 def test_an_unknown_table_is_not_found() -> None:
