+"""Hold the earliest free slot at a table that fits, for a guest."""
+
+from dataclasses import dataclass
+from datetime import date, time
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.booking.ports.id_generator.id_generator import IdGenerator
+from bistro.shared.result import Ok
+
+START_TIMES = [time(minutes // 60, minutes % 60) for minutes in range(17 * 60, 21 * 60 + 31, 30)]
+
+
+@dataclass(frozen=True)
+class HoldEarliestSlotInput:
+    day: date
+    party: int
+    guest: str
+
+
+@dataclass(frozen=True)
+class NoSlotFree:
+    reason: str
+
+
+type HoldEarliestSlotFailure = (
+    NoSlotFree
+)
+
+type HoldEarliestSlotOutput = Ok[Booking] | HoldEarliestSlotFailure
+
+
+class HoldEarliestSlot:
+    def __init__(self, bookings: BookingRepository, ids: IdGenerator) -> None:
+        self.bookings = bookings
+        self.ids = ids
+
+    def handle(self, input: HoldEarliestSlotInput) -> HoldEarliestSlotOutput:
+        fitting = sorted((t for t in self.bookings.tables() if t.seats >= input.party), key=lambda t: t.seats)
+        taken = {(b.table_id, b.slot.start) for b in self.bookings.bookings_on(input.day)}
+        for start in START_TIMES:
+            for table in fitting:
+                if (table.id, start) not in taken:
+                    booking = Booking(
+                        id=self.ids.next_id(),
+                        table_id=table.id,
+                        slot=Slot(day=input.day, start=start),
+                        party=input.party,
+                        guest=input.guest,
+                    )
+                    self.bookings.save(booking)
+                    return Ok(booking)
+        return NoSlotFree(f"no table for {input.party} is free on {input.day:%Y-%m-%d}")
diff --git a/src/bistro/booking/commands/hold_earliest_slot__test.py b/src/bistro/booking/commands/hold_earliest_slot__test.py
new file mode 100644
index 0000000..f6be0b4
--- /dev/null
+++ b/src/bistro/booking/commands/hold_earliest_slot__test.py
@@ -0,0 +1,62 @@
+from datetime import date, time
+
+from bistro.booking.commands.hold_earliest_slot import (
+    HoldEarliestSlot,
+    HoldEarliestSlotInput,
+    NoSlotFree,
+)
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.ports.id_generator.in_memory_id_generator import InMemoryIdGenerator
+from bistro.shared.result import Ok
+
+DAY = date(2026, 10, 9)
+
+
+def command() -> tuple[HoldEarliestSlot, InMemoryBookingRepository]:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=2), Table(id="t2", seats=4)])
+    hold = HoldEarliestSlot(
+        bookings=bookings,
+        ids=InMemoryIdGenerator(),
+    )
+    return hold, bookings
+
+
+def test_holds_the_earliest_slot_at_a_fitting_table() -> None:
+    hold, bookings = command()
+    result = hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Ada"))
+    expected = Booking(id="b1", table_id="t2", slot=Slot(day=DAY, start=time(17, 0)), party=3, guest="Ada")
+    assert result == Ok(expected)
+    assert bookings.booking_at("t2", expected.slot) == expected
+
+
+def test_the_next_caller_is_offered_another_slot() -> None:
+    hold, _ = command()
+    hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Ada"))
+    result = hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Grace"))
+    assert isinstance(result, Ok)
+    assert result.value.slot.start == time(17, 30)
+
+
+def test_a_full_day_has_no_slot() -> None:
+    hold, _ = command()
+    for _ in range(10):
+        hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Ada"))
+    result = hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Grace"))
+    assert isinstance(result, NoSlotFree)
+
+
+def test_the_last_slot_is_half_past_nine() -> None:
+    hold, _ = command()
+    results = [hold.handle(HoldEarliestSlotInput(day=DAY, party=3, guest="Ada")) for _ in range(10)]
+    last = results[-1]
+    assert isinstance(last, Ok)
+    assert last.value.slot.start == time(21, 30)
+
+
+def test_a_party_too_large_for_every_table_has_no_slot() -> None:
+    hold, _ = command()
+    result = hold.handle(HoldEarliestSlotInput(day=DAY, party=9, guest="Ada"))
+    assert isinstance(result, NoSlotFree)
