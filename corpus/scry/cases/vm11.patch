@@ -0,0 +1,64 @@
+from datetime import date, time
+
+from bistro.booking.commands.create_weekly_booking import (
+    CreateWeeklyBooking,
+    CreateWeeklyBookingInput,
+    InvalidWeekCount,
+    PartyTooLarge,
+    SlotTaken,
+    TableNotFound,
+)
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.ports.id_generator.in_memory_id_generator import InMemoryIdGenerator
+from bistro.shared.result import Ok
+
+SEVEN = Slot(day=date(2026, 10, 9), start=time(19, 0))
+NEXT_WEEK = Slot(day=date(2026, 10, 16), start=time(19, 0))
+IN_TWO_WEEKS = Slot(day=date(2026, 10, 23), start=time(19, 0))
+
+
+def command() -> tuple[CreateWeeklyBooking, InMemoryBookingRepository]:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=4)])
+    create = CreateWeeklyBooking(
+        bookings=bookings,
+        ids=InMemoryIdGenerator(),
+    )
+    return create, bookings
+
+
+def weekly(slot: Slot = SEVEN, party: int = 2, weeks: int = 3, table_id: str = "t1") -> CreateWeeklyBookingInput:
+    return CreateWeeklyBookingInput(table_id=table_id, slot=slot, party=party, guest="Ada", weeks=weeks)
+
+
+def test_books_the_same_time_for_consecutive_weeks() -> None:
+    create, bookings = command()
+    result = create.handle(weekly())
+    assert isinstance(result, Ok)
+    assert [b.slot for b in result.value] == [SEVEN, NEXT_WEEK, IN_TWO_WEEKS]
+    assert all(bookings.booking_at("t1", slot) is not None for slot in [SEVEN, NEXT_WEEK, IN_TWO_WEEKS])
+
+
+def test_one_taken_week_books_nothing() -> None:
+    create, bookings = command()
+    create.handle(weekly(slot=IN_TWO_WEEKS, weeks=1))
+    result = create.handle(weekly())
+    assert isinstance(result, SlotTaken)
+    assert bookings.booking_at("t1", SEVEN) is None
+    assert bookings.booking_at("t1", NEXT_WEEK) is None
+
+
+def test_a_party_larger_than_the_table_is_refused() -> None:
+    create, _ = command()
+    assert isinstance(create.handle(weekly(party=6)), PartyTooLarge)
+
+
+def test_an_unknown_table_is_not_found() -> None:
+    create, _ = command()
+    assert isinstance(create.handle(weekly(table_id="t9")), TableNotFound)
+
+
+def test_fewer_than_one_week_is_refused() -> None:
+    create, _ = command()
+    assert isinstance(create.handle(weekly(weeks=0)), InvalidWeekCount)
