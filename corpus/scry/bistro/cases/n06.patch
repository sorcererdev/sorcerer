@@ -0,0 +1,48 @@
+"""Change the party size of an existing booking."""
+
+from dataclasses import dataclass, replace
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.shared.result import Ok
+
+
+@dataclass(frozen=True)
+class ChangePartySizeInput:
+    booking_id: str
+    party: int
+
+
+@dataclass(frozen=True)
+class BookingNotFound:
+    reason: str
+
+
+@dataclass(frozen=True)
+class PartyTooLarge:
+    reason: str
+
+
+type ChangePartySizeFailure = (
+    BookingNotFound
+    | PartyTooLarge
+)
+
+type ChangePartySizeOutput = Ok[Booking] | ChangePartySizeFailure
+
+
+class ChangePartySize:
+    def __init__(self, bookings: BookingRepository) -> None:
+        self.bookings = bookings
+
+    def handle(self, input: ChangePartySizeInput) -> ChangePartySizeOutput:
+        booking = self.bookings.booking(input.booking_id)
+        if booking is None:
+            return BookingNotFound(f"there is no booking {input.booking_id}")
+        table = self.bookings.table(booking.table_id)
+        if table is None or input.party > table.seats:
+            seats = table.seats if table else 0
+            return PartyTooLarge(f"table {booking.table_id} seats {seats}, not {input.party}")
+        changed = replace(booking, party=input.party)
+        self.bookings.save(changed)
+        return Ok(changed)
diff --git a/src/bistro/booking/commands/change_party_size__test.py b/src/bistro/booking/commands/change_party_size__test.py
new file mode 100644
index 0000000..6bf9d3c
--- /dev/null
+++ b/src/bistro/booking/commands/change_party_size__test.py
@@ -0,0 +1,45 @@
+from datetime import date, time
+
+from bistro.booking.commands.change_party_size import (
+    BookingNotFound,
+    ChangePartySize,
+    ChangePartySizeInput,
+    PartyTooLarge,
+)
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.shared.result import Ok
+
+SEVEN = Slot(day=date(2026, 10, 9), start=time(19, 0))
+
+
+def command() -> tuple[ChangePartySize, InMemoryBookingRepository]:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=4)])
+    bookings.save(Booking(id="b1", table_id="t1", slot=SEVEN, party=2, guest="Ada"))
+    return ChangePartySize(bookings=bookings), bookings
+
+
+def test_changes_the_party_size() -> None:
+    change, bookings = command()
+    result = change.handle(ChangePartySizeInput(booking_id="b1", party=4))
+    assert result == Ok(Booking(id="b1", table_id="t1", slot=SEVEN, party=4, guest="Ada"))
+    assert isinstance(result, Ok)
+    assert bookings.booking("b1") == result.value
+    assert len(bookings.bookings_on(SEVEN.day)) == 1
+
+
+def test_a_party_larger_than_the_table_is_refused() -> None:
+    change, bookings = command()
+    result = change.handle(ChangePartySizeInput(booking_id="b1", party=5))
+    assert isinstance(result, PartyTooLarge)
+    booking = bookings.booking("b1")
+    assert booking is not None
+    assert booking.party == 2
+
+
+def test_an_unknown_booking_is_not_found() -> None:
+    change, _ = command()
+    result = change.handle(ChangePartySizeInput(booking_id="b9", party=2))
+    assert isinstance(result, BookingNotFound)
