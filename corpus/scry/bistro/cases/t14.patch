@@ -0,0 +1,28 @@
+from datetime import date, datetime, time
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.ports.clock.in_memory_clock import InMemoryClock
+from bistro.booking.queries.get_upcoming_bookings import GetUpcomingBookings
+
+TODAY = date(2026, 10, 9)
+
+
+def booking(id: str, day: date, start: time) -> Booking:
+    return Booking(id=id, table_id="t1", slot=Slot(day=day, start=start), party=2, guest="Ada")
+
+
+def test_lists_todays_bookings_not_yet_started_earliest_first() -> None:
+    bookings = InMemoryBookingRepository()
+    late = booking("b1", TODAY, time(21, 0))
+    early = booking("b2", TODAY, time(19, 0))
+    started = booking("b3", TODAY, time(12, 0))
+    tomorrow = booking("b4", date(2026, 10, 10), time(20, 0))
+    for each in (late, early, started, tomorrow):
+        bookings.save(each)
+    query = GetUpcomingBookings(
+        bookings=bookings,
+        clock=InMemoryClock(datetime(2026, 10, 9, 18, 0)),
+    )
+    assert query.handle() == [early, late]
