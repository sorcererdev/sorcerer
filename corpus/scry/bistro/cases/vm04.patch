diff --git a/src/bistro/web/bookings/routes.py b/src/bistro/web/bookings/routes.py
index 76bceac..022afa4 100644
--- a/src/bistro/web/bookings/routes.py
+++ b/src/bistro/web/bookings/routes.py
@@ -1,6 +1,6 @@
 """Bookings on the web: the day page, and booking a table (htmx)."""
 
-from datetime import date, time
+from datetime import date, datetime, time
 from pathlib import Path
 from typing import Annotated
 
@@ -50,4 +50,28 @@ def bookings_routes(get_day_schedule: GetDaySchedule, create_booking: CreateBook
                     request, "failure.html", {"reason": failure.reason}, status_code=create_booking_status(failure)
                 )
 
+    @router.post("/walk_in", response_class=HTMLResponse)
+    def walk_in(
+        request: Request,
+        party: Annotated[int, Form()],
+        guest: Annotated[str, Form()],
+    ) -> HTMLResponse:
+        now = datetime.now()
+        slot = Slot(day=now.date(), start=time(now.hour, 30 if now.minute >= 30 else 0))
+        schedule = get_day_schedule.handle(slot.day)
+        taken = {b.table_id for b in schedule.bookings if b.slot.start == slot.start}
+        free = sorted((t for t in schedule.tables if t.seats >= party and t.id not in taken), key=lambda t: t.seats)
+        if not free:
+            return TEMPLATES.TemplateResponse(
+                request, "failure.html", {"reason": "No free table fits the party"}, status_code=409
+            )
+        result = create_booking.handle(CreateBookingInput(table_id=free[0].id, slot=slot, party=party, guest=guest))
+        match result:
+            case Ok(value=booking):
+                return TEMPLATES.TemplateResponse(request, "booking.html", {"booking": booking}, status_code=201)
+            case failure:
+                return TEMPLATES.TemplateResponse(
+                    request, "failure.html", {"reason": failure.reason}, status_code=create_booking_status(failure)
+                )
+
     return router
