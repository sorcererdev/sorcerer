@@ -0,0 +1,61 @@
+"""Book a table at the same time for consecutive weeks, all or nothing."""
+
+from dataclasses import dataclass, replace
+from datetime import timedelta
+
+from bistro.booking.commands.create_booking import PartyTooLarge, SlotTaken, TableNotFound
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.booking.ports.id_generator.id_generator import IdGenerator
+from bistro.shared.result import Ok
+
+
+@dataclass(frozen=True)
+class CreateWeeklyBookingInput:
+    table_id: str
+    slot: Slot
+    party: int
+    guest: str
+    weeks: int
+
+
+@dataclass(frozen=True)
+class InvalidWeekCount:
+    reason: str
+
+
+type CreateWeeklyBookingFailure = (
+    SlotTaken
+    | PartyTooLarge
+    | TableNotFound
+    | InvalidWeekCount
+)
+
+type CreateWeeklyBookingOutput = Ok[list[Booking]] | CreateWeeklyBookingFailure
+
+
+class CreateWeeklyBooking:
+    def __init__(self, bookings: BookingRepository, ids: IdGenerator) -> None:
+        self.bookings = bookings
+        self.ids = ids
+
+    def handle(self, input: CreateWeeklyBookingInput) -> CreateWeeklyBookingOutput:
+        if input.weeks < 1:
+            return InvalidWeekCount(f"cannot book {input.weeks} weeks")
+        table = self.bookings.table(input.table_id)
+        if table is None:
+            return TableNotFound(f"there is no table {input.table_id}")
+        if input.party > table.seats:
+            return PartyTooLarge(f"table {table.id} seats {table.seats}, not {input.party}")
+        slots = [replace(input.slot, day=input.slot.day + timedelta(weeks=week)) for week in range(input.weeks)]
+        for slot in slots:
+            if self.bookings.booking_at(table.id, input.slot) is not None:
+                return SlotTaken(f"table {table.id} is booked on {slot.day} at {slot.start:%H:%M}")
+        made = [
+            Booking(id=self.ids.next_id(), table_id=table.id, slot=slot, party=input.party, guest=input.guest)
+            for slot in slots
+        ]
+        for booking in made:
+            self.bookings.save(booking)
+        return Ok(made)
