+def test_a_blank_guest_name_is_refused() -> None:
+    create, _ = command()
+    with pytest.raises(ValueError):
+        create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="   "))
+
+
+def test_a_guest_name_over_60_characters_is_refused() -> None:
+    create, _ = command()
+    with pytest.raises(ValueError):
+        create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="a" * 61))
+
+
+def test_a_guest_name_of_60_characters_is_accepted() -> None:
+    create, _ = command()
+    result = create.handle(CreateBookingInput(table_id="t1", slot=SEVEN, party=2, guest="a" * 60))
+    assert isinstance(result, Ok)
+
