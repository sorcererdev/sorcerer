+
+
+def test_swaps_the_tables_of_two_bookings(repository: BookingRepository) -> None:
+    eight = Slot(day=SEVEN.day, start=time(20, 0))
+    first = Booking(id="b1", table_id="t1", slot=SEVEN, party=3, guest="Ada")
+    second = Booking(id="b2", table_id="t2", slot=eight, party=2, guest="Grace")
+    repository.save(first)
+    repository.save(second)
+    repository.swap_tables("b1", "b2")
+    assert repository.booking_at("t2", SEVEN) == Booking(id="b1", table_id="t2", slot=SEVEN, party=3, guest="Ada")
+    assert repository.booking_at("t1", eight) == Booking(id="b2", table_id="t1", slot=eight, party=2, guest="Grace")
diff --git a/src/bistro/booking/ports/booking_repository/in_memory_booking_repository.py b/src/bistro/booking/ports/booking_repository/in_memory_booking_repository.py
index d6df9c1..bf7ec71 100644
--- a/src/bistro/booking/ports/booking_repository/in_memory_booking_repository.py
+++ b/src/bistro/booking/ports/booking_repository/in_memory_booking_repository.py
@@ -27,3 +27,10 @@ class InMemoryBookingRepository:
 
     def save(self, booking: Booking) -> None:
         self._bookings.append(booking)
+
+    def swap_tables(self, first_booking_id: str, second_booking_id: str) -> None:
+        first = next(i for i, b in enumerate(self._bookings) if b.id == first_booking_id)
+        second = next(i for i, b in enumerate(self._bookings) if b.id == second_booking_id)
+        a, b = self._bookings[first], self._bookings[second]
+        self._bookings[first] = Booking(id=a.id, table_id=b.table_id, slot=a.slot, party=a.party, guest=a.guest)
+        self._bookings[second] = Booking(id=b.id, table_id=a.table_id, slot=b.slot, party=b.party, guest=b.guest)
