@@ -0,0 +1,39 @@
+from datetime import date, time
+
+from bistro.booking.commands.seat_walk_in import NoTableFits, SeatWalkIn, SeatWalkInInput
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.ports.id_generator.in_memory_id_generator import InMemoryIdGenerator
+from bistro.shared.result import Ok
+
+SEVEN = Slot(day=date(2026, 10, 9), start=time(19, 0))
+
+
+def command() -> SeatWalkIn:
+    bookings = InMemoryBookingRepository(tables=[Table(id="big", seats=6), Table(id="small", seats=2), Table(id="mid", seats=4)])
+    return SeatWalkIn(
+        bookings=bookings,
+        ids=InMemoryIdGenerator(),
+    )
+
+
+def test_seats_the_party_at_the_smallest_table_that_fits() -> None:
+    result = command().handle(SeatWalkInInput(slot=SEVEN, party=3, guest="Walk-in"))
+    assert result == Ok(Booking(id="b1", table_id="mid", slot=SEVEN, party=3, guest="Walk-in"))
+
+
+def test_skips_a_taken_table() -> None:
+    seat = command()
+    seat.handle(SeatWalkInInput(slot=SEVEN, party=3, guest="Ada"))
+    result = seat.handle(SeatWalkInInput(slot=SEVEN, party=3, guest="Grace"))
+    assert isinstance(result, Ok)
+    assert result.value.table_id == "big"
+
+
+def test_refuses_when_no_free_table_fits() -> None:
+    seat = command()
+    seat.handle(SeatWalkInInput(slot=SEVEN, party=5, guest="Ada"))
+    assert isinstance(seat.handle(SeatWalkInInput(slot=SEVEN, party=5, guest="Grace")), NoTableFits)
+    assert isinstance(seat.handle(SeatWalkInInput(slot=SEVEN, party=9, guest="Grace")), NoTableFits)
