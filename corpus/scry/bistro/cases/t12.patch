@@ -0,0 +1,43 @@
+"""Seat a walk-in party at the smallest free table that fits."""
+
+from dataclasses import dataclass
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+from bistro.booking.ports.id_generator.id_generator import IdGenerator
+from bistro.shared.result import Ok
+
+
+@dataclass(frozen=True)
+class SeatWalkInInput:
+    slot: Slot
+    party: int
+    guest: str
+
+
+@dataclass(frozen=True)
+class NoTableFits:
+    reason: str
+
+
+type SeatWalkInFailure = (
+    NoTableFits
+)
+
+type SeatWalkInOutput = Ok[Booking] | SeatWalkInFailure
+
+
+class SeatWalkIn:
+    def __init__(self, bookings: BookingRepository, ids: IdGenerator) -> None:
+        self.bookings = bookings
+        self.ids = ids
+
+    def handle(self, input: SeatWalkInInput) -> SeatWalkInOutput:
+        fitting = sorted((t for t in self.bookings.tables() if t.seats >= input.party), key=lambda t: (t.seats, t.id))
+        table = next((t for t in fitting if self.bookings.booking_at(t.id, input.slot) is None), None)
+        if table is None:
+            return NoTableFits(f"no free table seats {input.party} at {input.slot.start:%H:%M}")
+        booking = Booking(id=self.ids.next_id(), table_id=table.id, slot=input.slot, party=input.party, guest=input.guest)
+        self.bookings.save(booking)
+        return Ok(booking)
