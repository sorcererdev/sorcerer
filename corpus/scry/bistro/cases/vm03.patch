+{% extends "base.html" %}
+{% block title %}Bookings — {{ name }}{% endblock %}
+{% block content %}
+  <h1>Bookings — {{ name }}</h1>
+  <ul>
+    {% for booking in bookings %}
+    <li>{{ booking.slot.day }} {{ booking.slot.start.strftime("%H:%M") }} · {{ booking.table_id }} · party of {{ booking.party }}</li>
+    {% endfor %}
+  </ul>
+{% endblock %}
