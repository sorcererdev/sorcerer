+"""Today's bookings that have not started yet, earliest first, for the host stand (a query)."""
+
+from datetime import datetime
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.ports.booking_repository.booking_repository import BookingRepository
+
+
+class GetUpcomingBookings:
+    def __init__(self, bookings: BookingRepository) -> None:
+        self.bookings = bookings
+
+    def handle(self) -> list[Booking]:
+        now = datetime.now()
+        upcoming = [booking for booking in self.bookings.bookings_on(now.date()) if booking.slot.start > now.time()]
+        return sorted(upcoming, key=lambda booking: booking.slot.start)
