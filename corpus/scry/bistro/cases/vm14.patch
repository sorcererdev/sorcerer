+from datetime import date, time, timedelta
+
+from bistro.booking.models.booking import Booking
+from bistro.booking.models.slot import Slot
+from bistro.booking.models.table import Table
+from bistro.booking.ports.booking_repository.in_memory_booking_repository import InMemoryBookingRepository
+from bistro.booking.queries.get_upcoming_bookings import GetUpcomingBookings
+
+
+def test_other_days_are_not_listed() -> None:
+    bookings = InMemoryBookingRepository(tables=[Table(id="t1", seats=4)])
+    for i, day in enumerate([date.today() - timedelta(days=1), date.today() + timedelta(days=1)]):
+        bookings.save(Booking(id=f"b{i}", table_id="t1", slot=Slot(day=day, start=time(19, 0)), party=2, guest="Ada"))
+    assert GetUpcomingBookings(
+        bookings=bookings,
+    ).handle() == []
