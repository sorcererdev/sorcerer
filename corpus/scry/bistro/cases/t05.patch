@@ -47,6 +59,10 @@ class CreateBooking:
         self.ids = ids
 
     def handle(self, input: CreateBookingInput) -> CreateBookingOutput:
+        if input.slot.day.weekday() == MONDAY:
+            return OutsideOpeningHours("the restaurant is closed on Mondays")
+        if not OPENING <= input.slot.start <= LAST_BOOKING:
