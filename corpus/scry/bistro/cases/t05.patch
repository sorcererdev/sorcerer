@@ -9,6 +10,11 @@ from bistro.booking.ports.id_generator.id_generator import IdGenerator
 from bistro.shared.result import Ok
 
 
+MONDAY = 0
+OPENING = time(17, 0)
+LAST_BOOKING = time(21, 30)
+
+
 @dataclass(frozen=True)
 class CreateBookingInput:
     table_id: str
@@ -32,10 +38,16 @@ class TableNotFound:
