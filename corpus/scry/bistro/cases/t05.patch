diff --git a/src/bistro/booking/commands/create_booking__test.py b/src/bistro/booking/commands/create_booking__test.py
index 2be3b88..49f6248 100644
--- a/src/bistro/booking/commands/create_booking__test.py
+++ b/src/bistro/booking/commands/create_booking__test.py
@@ -3,6 +3,7 @@ from datetime import date, time
 from bistro.booking.commands.create_booking import (
     CreateBooking,
     CreateBookingInput,
+    OutsideOpeningHours,
     PartyTooLarge,
     SlotTaken,
     TableNotFound,
@@ -47,6 +48,34 @@ def test_a_party_larger_than_the_table_is_refused() -> None:
     assert isinstance(result, PartyTooLarge)
 
 
+def test_a_monday_is_closed() -> None:
+    create, _ = command()
+    monday = Slot(day=date(2026, 10, 12), start=time(19, 0))
+    result = create.handle(CreateBookingInput(table_id="t1", slot=monday, party=2, guest="Ada"))
+    assert isinstance(result, OutsideOpeningHours)
+
+
+def test_before_opening_is_refused() -> None:
+    create, _ = command()
+    early = Slot(day=date(2026, 10, 9), start=time(16, 30))
+    result = create.handle(CreateBookingInput(table_id="t1", slot=early, party=2, guest="Ada"))
+    assert isinstance(result, OutsideOpeningHours)
+
+
+def test_after_the_last_booking_is_refused() -> None:
+    create, _ = command()
+    late = Slot(day=date(2026, 10, 9), start=time(22, 0))
+    result = create.handle(CreateBookingInput(table_id="t1", slot=late, party=2, guest="Ada"))
+    assert isinstance(result, OutsideOpeningHours)
+
+
+def test_the_last_booking_time_is_accepted() -> None:
+    create, _ = command()
+    last = Slot(day=date(2026, 10, 9), start=time(21, 30))
+    result = create.handle(CreateBookingInput(table_id="t1", slot=last, party=2, guest="Ada"))
+    assert isinstance(result, Ok)
+
+
 def test_an_unknown_table_is_not_found() -> None:
     create, _ = command()
     result = create.handle(CreateBookingInput(table_id="t9", slot=SEVEN, party=2, guest="Ada"))
