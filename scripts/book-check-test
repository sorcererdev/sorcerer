#!/usr/bin/env bash
# Tests scripts/book-check over throwaway repositories.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
check="$here/book-check"
passed=0

# case NAME EXPECTED_EXIT EXPECTED_STDOUT_FRAGMENT TRAILER FILE...
case_() {
  local name=$1 want=$2 fragment=$3 trailer=$4; shift 4
  local d; d=$(mktemp -d)
  (
    cd "$d"
    git init -q -b main
    git config user.name t; git config user.email t@example.com
    echo root > README.md; git add -A; git commit -q -m root
    git checkout -q -b work
    for f in "$@"; do mkdir -p "$(dirname "$f")"; echo change >> "$f"; done
    git add -A
    if [ -n "$trailer" ]; then git commit -q -m "change" -m "$trailer"; else git commit -q -m change; fi
    set +e; out=$("$check" main); got=$?; set -e
    if [ "$got" != "$want" ]; then echo "FAIL $name: exit $got, wanted $want ($out)"; exit 1; fi
    if [ -n "$fragment" ] && ! grep -q -- "$fragment" <<<"$out"; then echo "FAIL $name: output lacks '$fragment': $out"; exit 1; fi
  )
  rm -rf "$d"
  passed=$((passed + 1))
}

case_ "code without book" 1 "book/" "" crates/x/src/a.rs
case_ "code with book" 0 "" "" crates/x/src/a.rs book/user/src/a.md
case_ "code with trailer" 0 "" "Book: test-only fix" crates/x/src/a.rs
case_ "readme only" 0 "" "" README.md
echo "$passed passed"
