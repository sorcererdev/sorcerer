#!/usr/bin/env python3
"""Port inspect's 58 bistro cases and 1a's recordings into corpus/scry (one-off, kept for the record).

    python3 -I scripts/port-scry-corpus <notes>/experiments <olifant>/src/Olifant/Inspect/testdata corpus/scry

Writes base/ (git archive of the conventions base HEAD, .olifant dropped), cases/ (the
labelled cases' .toml and .patch), steering.md (1a's vet.md), labels.json, finds/<case>.json,
checks.json and README.md. corpus/scry/jev/ is not touched: the gate records it.
"""

import hashlib
import io
import json
import re
import shutil
import subprocess
import sys
import tarfile
from pathlib import Path


def sha256(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def collapse(s: str) -> str:
    return " ".join(s.split())


def main() -> None:
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    experiments, testdata, out = (Path(a).resolve() for a in sys.argv[1:])
    conv = experiments / "code-checker-conventions-2026-11-14"
    vet = experiments / "vet-1a-2026-11-15" / "vet.md"
    labels_src = testdata / "inspect-corpus-labels.json"
    finds_src = testdata / "inspect-corpus-finds.json"
    checks_src = testdata / "inspect-corpus-checks.json"

    for d in ["base", "cases", "finds"]:
        shutil.rmtree(out / d, ignore_errors=True)
    out.mkdir(parents=True, exist_ok=True)

    # base: HEAD of the conventions base, plain files, without .olifant
    head = subprocess.run(
        ["git", "-C", str(conv / "base"), "rev-parse", "HEAD"], check=True, capture_output=True, text=True
    ).stdout.strip()
    tar = subprocess.run(["git", "-C", str(conv / "base"), "archive", "HEAD"], check=True, capture_output=True).stdout
    with tarfile.open(fileobj=io.BytesIO(tar)) as t:
        members = [m for m in t.getmembers() if not (m.name == ".olifant" or m.name.startswith(".olifant/"))]
        t.extractall(out / "base", members=members, filter="data")

    # labels: {case: {set, hits, changed}}
    raw = json.loads(labels_src.read_text())
    labels = {
        cid: {"set": c["set"], "hits": c["hits"], "changed": c["changed"]} for cid, c in sorted(raw.items())
    }
    (out / "labels.json").write_text(json.dumps(labels, indent=2, ensure_ascii=False) + "\n")

    # cases: the labelled ones only (the three borderlines stay behind)
    (out / "cases").mkdir()
    for cid, c in raw.items():
        assert c["patch"] == f"cases/{cid}.patch", c["patch"]
        for ext in ["toml", "patch"]:
            shutil.copyfile(conv / "cases" / f"{cid}.{ext}", out / "cases" / f"{cid}.{ext}")

    shutil.copyfile(vet, out / "steering.md")

    # finds: per case, the per-file replies merged into one reply
    finds = json.loads(finds_src.read_text())
    (out / "finds").mkdir()
    for cid in sorted(labels):
        findings, open_ = [], []
        for _file, text in sorted(finds.get(cid, {}).items()):
            reply = json.loads(text)
            findings += reply.get("findings", [])
            open_ += reply.get("open", [])
        assert not open_, cid
        reply = json.dumps({"findings": findings, "open": []}, ensure_ascii=False)
        (out / "finds" / f"{cid}.json").write_text(
            json.dumps({"reply": reply, "cost_usd": 0.04}, indent=2, ensure_ascii=False) + "\n"
        )

    # checks: {statement, whitespace collapsed: verdict word}
    replies = json.loads(checks_src.read_text())["replies"]
    checks = {}
    for statement, r in sorted(replies.items()):
        m = re.search(r'"verdict"\s*:\s*"(\w+)"', r["text"])
        assert m, statement
        word = {"right": "right", "wrong": "wrong"}.get(m.group(1), "cannot_tell")
        checks[collapse(statement)] = word
    (out / "checks.json").write_text(json.dumps(checks, indent=2, ensure_ascii=False) + "\n")

    sources = [
        ("base/", f"`git archive HEAD` of `{conv / 'base'}` at `{head}`, `.olifant/` dropped"),
        ("cases/", f"`{conv / 'cases'}`, the 58 labelled cases (the borderlines bl01-bl03 left out)"),
        ("steering.md", f"`{vet}` (sha256 `{sha256(vet)}`)"),
        ("labels.json", f"`{labels_src}` (sha256 `{sha256(labels_src)}`), `patch` dropped"),
        (
            "finds/<case>.json",
            f"`{finds_src}` (sha256 `{sha256(finds_src)}`): 1a's sonnet replies, one per changed file, "
            "merged into one reply per case",
        ),
        (
            "checks.json",
            f"`{checks_src}` (sha256 `{sha256(checks_src)}`): 1a's claim-check verdicts by statement",
        ),
        (
            "jev/<key>.json",
            "Jev's answers, one file per question. 43 recorded live by the gate (`SCRY_RECORD_JEV=1`, "
            "2026-11-18); 3 (`246641af322a93f4`, `28d40b419ee79956`, `aa472c0c767b131a`) seeded from "
            f"`{testdata / 'inspect-corpus-jev.json'}` (same keys), `{{choice, confidence}}` converted to "
            "`{noul: P(yes), type: noul}`, for the questions the same-pass merge rule asks; "
            "`5988dcc32dcd0b79` and `8d40d48fd13b0094` are live answers the gate no longer asks",
        ),
    ]
    readme = [
        "# The scry corpus",
        "",
        "Inspect's 1b replay gate, ported: 58 bistro cases (18 V-must, 8 B, 18 T, 8 N, 6 V-taste) and",
        "the recordings `crates/scry/tests/gate.rs` replays. Written by `scripts/port-scry-corpus`;",
        "the notes directory is not under git, so each source is pinned by its sha256.",
        "",
        "| path | from |",
        "|---|---|",
    ]
    readme += [f"| `{p}` | {w} |" for p, w in sources]
    readme += [
        "",
        "Paths are on the machine that ran the port; `~/projects/notes/durandal/experiments` and",
        "`~/projects/olifant/src/Olifant/Inspect/testdata`.",
        "",
    ]
    home = str(Path.home())
    (out / "README.md").write_text("\n".join(readme).replace(home, "~"))


if __name__ == "__main__":
    main()
