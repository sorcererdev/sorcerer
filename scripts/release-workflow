#!/usr/bin/env bash
# Regenerates .github/workflows/release.yml with dist, then patches the one thing dist 0.34.0
# writes wrong: a custom job's `uses: $/.github/workflows/<job>.yml`, which GitHub refuses,
# becomes `uses: ./.github/workflows/<job>.yml`. dist-workspace.toml sets allow-dirty = ["ci"]
# so dist accepts the patched file; this script is what keeps it generated.
# Usage: release-workflow [--check]   (--check: exit 1 when the committed file differs)
set -euo pipefail
cd "$(dirname "$0")/.."
config=dist-workspace.toml
workflow=.github/workflows/release.yml
work=$(mktemp -d)
cp "$config" "$work/config"
cp "$workflow" "$work/committed"
check=${1:-}
# on any exit, even an interrupted one: the config as it was, and with --check the committed
# release.yml
trap 'cp "$work/config" "$config"; if [ "$check" = "--check" ]; then cp "$work/committed" "$workflow"; fi; rm -rf "$work"' EXIT

# without allow-dirty, dist generate rewrites the file
grep -v '^allow-dirty' "$work/config" > "$config"
dist generate --mode=ci > /dev/null 2>&1
sed 's|uses: \$/\.github/|uses: ./.github/|' "$workflow" > "$work/generated"

if [ "$check" = "--check" ]; then
  if ! diff -u "$work/committed" "$work/generated"; then
    echo "release.yml is not what scripts/release-workflow generates; run it and commit the file"
    exit 1
  fi
else
  cp "$work/generated" "$workflow"
fi
